<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link href="https://fonts.googleapis.com/css?family=Roboto:300,400,500,700&display=swap" rel="stylesheet" />
    <link href="_content/MudBlazor/MudBlazor.min.css" rel="stylesheet" />
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["FluentFlow.Web.styles.css"]" />
    <ImportMap />
    <link rel="icon" type="image/png" href="favicon.svg" />
    <link rel="manifest" href="manifest.webmanifest" />
    <meta name="theme-color" content="#594AE2" />
    <HeadOutlet @rendermode="RenderModeForPage" />
    <style>
        #app-loading {
            position: fixed;
            inset: 0;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            background: #ffffff;
            z-index: 9999;
            transition: opacity 0.4s ease;
        }
        #app-loading.hidden {
            opacity: 0;
            pointer-events: none;
        }
        .loading-logo {
            font-family: 'Roboto', sans-serif;
            font-size: 2rem;
            font-weight: 700;
            color: #594AE2;
            margin-bottom: 28px;
        }
        .loading-spinner {
            width: 40px;
            height: 40px;
            border: 4px solid #E8E5FF;
            border-top-color: #594AE2;
            border-radius: 50%;
            animation: ff-spin 0.8s linear infinite;
        }
        .loading-hint {
            font-family: 'Roboto', sans-serif;
            font-size: 0.8rem;
            color: #9E9E9E;
            margin-top: 16px;
        }
        @@keyframes ff-spin {
            to { transform: rotate(360deg); }
        }
    </style>
</head>
<body>

<div id="app-loading">
    <div class="loading-logo">FluentFlow</div>
    <div class="loading-spinner"></div>
    <div class="loading-hint">Loading...</div>
</div>

<FluentFlow.Web.Client.Components.Routes @rendermode="RenderModeForPage" />
<ReconnectModal />

<script src="@Assets["_framework/blazor.web.js"]" autostart="false"></script>
<script src="app.js"></script>
<script src="recording.js"></script>
<script src="audio-player.js"></script>
<script src="_content/MudBlazor/MudBlazor.min.js"></script>
<script>
    window.addEventListener('load', () => {
        console.log('[WINDOW] load');
        //setTimeout(() => {hideLoading();}, 3000);
    });

    document.addEventListener('DOMContentLoaded', () => {
        console.log('[DOM] DOMContentLoaded');
    });

    window.addEventListener('beforeunload', () => {
        console.log('[WINDOW] beforeunload');
    });

    window.addEventListener('error', (e) => {
        console.error('[WINDOW] error:', e.error);
    });

    window.addEventListener('unhandledrejection', (e) => {
        console.error('[WINDOW] unhandledrejection:', e.reason);
    });
    
    Blazor.start({
        ssr: {
            loadBootResource: function (type, name, defaultUri, integrity) {
                console.log(`[SSR] loadBootResource → type=${type}, name=${name}`);
                return defaultUri;
            },
            beforeStart: function (options) {
                console.log('[SSR] beforeStart');
                console.log('[SSR] options:', options);
            },
            afterStarted: function (blazor) {
                console.log('[SSR] afterStarted');
                console.log('[SSR] Blazor instance:', blazor);
            },
            onCircuitOpened: function () {
                console.log('[SSR] Circuit opened');
            },
            onCircuitClosed: function () {
                console.log('[SSR] Circuit closed');
            },
            onCircuitError: function (error) {
                console.error('[SSR] Circuit error:', error);
            }
        },

        webAssembly: {
            loadBootResource: function (type, name, defaultUri, integrity) {
                console.log(`[WASM] loadBootResource → type=${type}, name=${name}`);
                if(name.includes("FluentFlow.Core.resources"))
                    setTimeout(() => {hideLoading();}, 3000);
                return defaultUri;
            },
            beforeStart: function (options) {
                console.log('[WASM] beforeStart');
                console.log('[WASM] options:', options);
            },
            afterStarted: function (blazor) {
                console.log('[WASM] afterStarted');
                console.log('[WASM] Blazor instance:', blazor);
            }
        }
    }).then(function () {
        console.log('[GLOBAL] Blazor.start completed successfully');        
    }).catch(function (err) {
        console.error('[GLOBAL] Blazor start error:', err);
        // Evita ficar preso no loading
        hideLoading();
    });
    
    if ('serviceWorker' in navigator) {
        navigator.serviceWorker.register('/service-worker.js');
    }
</script>
</body>
</html>

@code {
    private static readonly IComponentRenderMode RenderModeForPage =
        new InteractiveWebAssemblyRenderMode(prerender: false);
}