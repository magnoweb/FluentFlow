@inject TokenAuthStateProvider AuthProvider

<MudNavMenu>
    <MudNavLink Href="/" Icon="@Icons.Material.Filled.Home" Match="NavLinkMatch.All">Início</MudNavLink>
    <MudNavLink Href="/decks" Icon="@Icons.Material.Filled.LibraryBooks">Os meus Decks</MudNavLink>

    @if (_isAdmin)
    {
        <MudNavLink Href="/logs" Icon="@Icons.Material.Filled.BugReport">Logs</MudNavLink>
    }
</MudNavMenu>

@code {
    private bool _isAdmin;

    protected override async Task OnInitializedAsync()
    {
        var userType = await AuthProvider.GetUserTypeAsync();
        _isAdmin = userType == "Admin";
    }
}