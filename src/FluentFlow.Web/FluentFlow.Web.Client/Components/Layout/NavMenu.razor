@inject TokenAuthStateProvider AuthProvider

<MudNavMenu>
    <MudNavLink Href="/" Icon="@Icons.Material.Filled.Home" Match="NavLinkMatch.All">@Lang["Nav.Home"]</MudNavLink>
    <MudNavLink Href="/decks" Icon="@Icons.Material.Filled.LibraryBooks">@Lang["Nav.Decks"]</MudNavLink>
    <MudNavLink Href="/sessions" Icon="@Icons.Material.Filled.History">@Lang["Nav.Sessions"]</MudNavLink>
    @if (_isAdmin)
    {
        <MudNavLink Href="/logs" Icon="@Icons.Material.Filled.BugReport">@Lang["Nav.Logs"]</MudNavLink>
    }
</MudNavMenu>

@code {
    private bool _isAdmin;

    protected override async Task OnInitializedAsync()
    {
        var userType = await AuthProvider.GetUserTypeAsync();
        _isAdmin = userType == "Admin";
    }
}