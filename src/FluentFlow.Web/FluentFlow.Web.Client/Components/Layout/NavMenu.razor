@inject TokenAuthStateProvider AuthProvider

<MudNavMenu>
    <MudNavLink Href="/" Icon="@Icons.Material.Filled.Home" Match="NavLinkMatch.All">@Lang["Nav.Home"]</MudNavLink>
    <MudNavLink Href="/decks" Icon="@Icons.Material.Filled.LibraryBooks">@Lang["Nav.Decks"]</MudNavLink>
    <MudNavLink Href="/sessions" Icon="@Icons.Material.Filled.History">@Lang["Nav.Sessions"]</MudNavLink>
    @if (_isAdmin)
    {
        <MudNavGroup Title="@Lang["Admin.Title"]" Icon="@Icons.Material.Filled.AdminPanelSettings" Expanded="false">
            <MudNavLink Href="/admin/users" Icon="@Icons.Material.Filled.People">
                @Lang["Admin.Users.Title"]
            </MudNavLink>
            <MudNavLink Href="/admin/access-logs" Icon="@Icons.Material.Filled.History">
                @Lang["Admin.AccessLogs.Title"]
            </MudNavLink>
            <MudNavLink Href="/logs" Icon="@Icons.Material.Filled.BugReport">
                @Lang["Nav.Logs"]
            </MudNavLink>
        </MudNavGroup>
        
    }
</MudNavMenu>

@code {
    private bool _isAdmin;

    protected override async Task OnInitializedAsync()
    {
        var userType = await AuthProvider.GetUserTypeAsync();
        _isAdmin = userType == "Admin";
    }
}