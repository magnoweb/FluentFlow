@page "/login"
@layout EmptyLayout
@inject WebAuthService AuthService
@inject NavigationManager Nav
@inject ApiClient Api
@inject AppSettings AppSettings

<PageTitle>FluentFlow - @Lang["Auth.PageTitle"]</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-16">
    <MudPaper Class="pa-8" Elevation="3">

        <MudText Typo="Typo.h4" Align="Align.Center" Class="mb-6">
            @Lang["Common.AppTitle"]
        </MudText>

        <MudTextField @bind-Value="_email" Label="@Lang["Auth.Email"]" InputType="InputType.Email" Variant="Variant.Outlined" FullWidth Class="mb-4" />
        <MudTextField @bind-Value="_password" Label="@Lang["Auth.Password"]" InputType="InputType.Password" Variant="Variant.Outlined" FullWidth Class="mb-4" />

        @if (_error is not null)
        {
            <MudAlert Severity="Severity.Error" Class="mb-4">@_error</MudAlert>
        }

        <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth OnClick="LoginAsync" Disabled="_loading" Class="mb-4">
            @if (_loading)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate />
            }
            else
            {
                <span>@Lang["Auth.Login"]</span>
            }
        </MudButton>

        <MudDivider Class="mb-4" />

        <MudButton Variant="Variant.Outlined" FullWidth Class="mb-2" StartIcon="@Icons.Custom.Brands.Google" OnClick="@(() => SocialLogin("Google"))">
            @Lang["Auth.ContinueWithGoogle"]
        </MudButton>
        
        <MudButton Variant="Variant.Outlined" FullWidth StartIcon="@Icons.Custom.Brands.Microsoft" OnClick="@(() => SocialLogin("Microsoft"))">
            @Lang["Auth.ContinueWithMicrosoft"]
        </MudButton>

        @* <MudButton Variant="Variant.Outlined" FullWidth StartIcon="@Icons.Custom.Brands.GitHub" Href="/api/auth/login/GitHub"> *@
        @*     @Lang["Auth.ContinueWithGitHub"] *@
        @* </MudButton> *@

        <MudText Align="Align.Center" Class="mt-4">
            @Lang["Auth.NoAccount"]
            <MudLink Href="/register">@Lang["Auth.Register"]</MudLink>
        </MudText>
    </MudPaper>
</MudContainer>

@code {
    private string _email;
    private string _password;
    private string? _error;
    private bool _loading;

    [SupplyParameterFromQuery] private string? ReturnUrl { get; set; }
    
    protected override void OnInitialized()
    {
        if (AppSettings.Environment == "Development")
        {
            _email = "admin@fluentflow.com";
            _password = "Qawsed@12";
        }
    }

    private async Task LoginAsync()
    {
        _loading = true;
        _error   = null;

        var (success, error) = await AuthService.LoginAsync(new LoginDto(_email, _password));

        if (success)
            Nav.NavigateTo(ReturnUrl ?? "/decks");
        else
            _error = error;

        _loading = false;
    }

    private void SocialLogin(string provider)
    {
        // Redirecionar para a API — o callback volta para a app web
        var returnUrl = Nav.BaseUri.TrimEnd('/');
        Nav.NavigateTo($"{Api.ApiBaseUrl}api/auth/login/{provider}?returnUrl={Uri.EscapeDataString(returnUrl)}",
        forceLoad: true);
    }
}