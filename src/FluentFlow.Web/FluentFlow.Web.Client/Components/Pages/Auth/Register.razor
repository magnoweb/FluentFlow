@page "/register"
@layout EmptyLayout
@inject WebAuthService AuthService
@inject NavigationManager Nav

<PageTitle>FluentFlow - @Lang["appTitle"]</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-16">
    <MudPaper Class="pa-8" Elevation="3">

        <MudText Typo="Typo.h4" Align="Align.Center" Class="mb-6">
            @Lang["Auth.Register"]
        </MudText>

        <MudTextField @bind-Value="_name"
                      Label="@Lang["Auth.Name"]"
                      Variant="Variant.Outlined"
                      FullWidth
                      Class="mb-4" />

        <MudTextField @bind-Value="_email"
                      Label="@Lang["Auth.Email"]"
                      InputType="InputType.Email"
                      Variant="Variant.Outlined"
                      FullWidth
                      Class="mb-4" />

        <MudTextField @bind-Value="_password"
                      Label="@Lang["Auth.Password"]"
                      InputType="InputType.Password"
                      Variant="Variant.Outlined"
                      FullWidth
                      Class="mb-4" />

        @if (_error is not null)
        {
            <MudAlert Severity="Severity.Error" Class="mb-4">@_error</MudAlert>
        }

        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   FullWidth
                   OnClick="RegisterAsync"
                   Disabled="_loading">
            @if (_loading)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate />
            }
            else
            {
                <span>@Lang["Auth.Register"]</span>
            }
        </MudButton>

        <MudText Align="Align.Center" Class="mt-4">
            @Lang["Auth.AlreadyHaveAccount"]
            <MudLink Href="/login">@Lang["Auth.Login"]</MudLink>
        </MudText>

    </MudPaper>
</MudContainer>

@code {
    private string _name = "";
    private string _email = "";
    private string _password = "";
    private string? _error;
    private bool _loading;

    private async Task RegisterAsync()
    {
        _loading = true;
        _error   = null;

        var (success, error) = await AuthService.RegisterAsync(
            new FluentFlow.Core.DTOs.Auth.RegisterDto(_name, _email, _password));

        if (success)
            Nav.NavigateTo("/decks");
        else
            _error = error;

        _loading = false;
    }
}