@page "/sessions"
@inject ApiClient Api
@inject NavigationManager Nav

<PageTitle>@($"FluentFlow - {Lang["Sessions.Title"]}")</PageTitle>

<AuthorizeView>
    <Authorized>

        <MudText Typo="Typo.h5" Class="mb-4">
            @Lang["Sessions.ListTitle"]
        </MudText>

        <!-- Filtros -->
        <MudStack Row Class="mb-4" Spacing="2">
            @foreach (var filter in Filters)
            {
                <MudChip T="string" Color="@(_modeFilter == filter.Key ? Color.Primary : Color.Default)" OnClick="() => SetFilter(filter.Key)" Size="Size.Small">
                    @filter.Label
                </MudChip>
            }
        </MudStack>

        @if (_loading && !_sessions.Any())
        {
            <LoadingSpinner />
        }
        else if (!_sessions.Any())
        {
            <MudAlert Severity="Severity.Info">
                @Lang["Sessions.NoSessions"]
            </MudAlert>
        }
        else
        {
            <MudTable Items="_sessions" Hover Dense Breakpoint="Breakpoint.Md" Elevation="1">
                <HeaderContent>
                    <MudTh>@Lang["Sessions.Deck"]</MudTh>
                    <MudTh>@Lang["Sessions.Mode"]</MudTh>
                    <MudTh>@Lang["Sessions.Date"]</MudTh>
                    <MudTh>@Lang["Sessions.Cards"]</MudTh>
                    <MudTh>@Lang["Sessions.Score"]</MudTh>
                    <MudTh>@Lang["Sessions.Duration"]</MudTh>
                    <MudTh></MudTh>
                </HeaderContent>

                <RowTemplate Context="sessionContext">

                    <MudTd DataLabel="@Lang["Sessions.Deck"]">
                        <MudText Typo="Typo.body2" Style="font-weight:600">
                            @sessionContext.DeckName
                        </MudText>
                    </MudTd>

                    <MudTd DataLabel="@Lang["Sessions.Mode"]">
                        <MudChip T="string" Size="Size.Small" Color="@(sessionContext.Mode == "Listening" ? Color.Primary : Color.Secondary)">
                            @sessionContext.Mode.GetModeLabel(true)
                        </MudChip>
                    </MudTd>

                    <MudTd DataLabel="@Lang["Sessions.Date"]">
                        <MudText Typo="Typo.caption">
                            @sessionContext.StartedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                        </MudText>
                    </MudTd>

                    <MudTd DataLabel="@Lang["Sessions.Cards"]">
                        @sessionContext.ReviewedCards / @sessionContext.TotalCards
                    </MudTd>

                    <MudTd DataLabel="@Lang["Sessions.Score"]">
                        <MudText Style="@($"color:{ScoreColor(sessionContext.AverageScore)};font-weight:600")">
                            @sessionContext.AverageScore.ToString("F1") / 5
                        </MudText>
                    </MudTd>

                    <MudTd DataLabel="@Lang["Sessions.Duration"]">
                        @FormatDuration(sessionContext.Duration)
                    </MudTd>

                    <MudTd>
                        <MudIconButton Icon="@Icons.Material.Filled.Visibility" Size="Size.Small" Title="@Lang["Sessions.View"]"
                                       OnClick="@(() => Nav.NavigateTo($"/sessions/{sessionContext.Id}"))" />
                    </MudTd>

                </RowTemplate>
            </MudTable>

            @if (_paged?.TotalPages > 1)
            {
                <MudPagination Count="_paged!.TotalPages" Selected="_page" SelectedChanged="OnPageChanged" Class="mt-4" />
            }
        }

    </Authorized>

    <NotAuthorized>
        <RedirectToLogin />
    </NotAuthorized>
</AuthorizeView>

@code {
    private PagedResult<StudySessionListDto>? _paged;
    private List<StudySessionListDto> _sessions = [];
    private bool _loading = true;
    private int _page = 1;
    private string? _modeFilter;
    
    private (string? Key, string Label)[] Filters =>
    [
        (null, LocalizationHelper.T("Sessions.All")),
        ("Listening", $"🎧 {Lang["Study.Listening"]}"),
        ("Speaking", $"🗣️ {Lang["Study.Speaking"]}"),
    ];

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _paged = await Api.GetSessionsAsync(page: _page, pageSize: 20, modeFilter: _modeFilter);
        _sessions = _paged?.Items.ToList() ?? [];
        _loading  = false;
    }

    private async Task OnPageChanged(int page)
    {
        _page = page;
        await LoadAsync();
    }

    private async Task SetFilter(string? mode)
    {
        _modeFilter = mode;
        _page = 1;
        await LoadAsync();
    }

    private string ModeLabel(string mode)
    {
        var res = "";
        switch (mode)
        {
            case "Listening":
                res = $"🎧 {Lang["Study.Listening"]}";
                break;
            case "Speaking":
                res = $"🗣️ {Lang["Study.Speaking"]}";
                break;
        }

        return res;
    }

    private static string ScoreColor(double score) =>
        score >= 4.0 ? "#4CAF50"
        : score >= 2.5 ? "#FF9800"
        : "#F44336";

    private static string FormatDuration(TimeSpan? d) =>
        d is null ? "—"
        : d.Value.TotalMinutes >= 1
            ? $"{(int)d.Value.TotalMinutes}m {d.Value.Seconds}s"
            : $"{d.Value.Seconds}s";
}