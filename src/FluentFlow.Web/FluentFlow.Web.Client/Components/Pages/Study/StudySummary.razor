@page "/study/summary/{SessionId:guid}"
@using FluentFlow.Web.Client.Shared
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inject NavigationManager Nav

<PageTitle>Resumo da Sessão</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-8">
    <MudPaper Class="pa-8" Elevation="3">
        <MudText Typo="Typo.h4" Align="Align.Center" Class="mb-6">
            Sessão concluída! 🎉
        </MudText>

        <MudGrid Class="mb-6">
            <MudItem xs="6">
                <StatCard Label="Cards revistos" Value="@Reviewed.ToString()" />
            </MudItem>
            <MudItem xs="6">
                <StatCard Label="Score médio" Value="@($"{Average:F1}/5")" />
            </MudItem>
        </MudGrid>

        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   FullWidth OnClick="@(() => Nav.NavigateTo("decks"))">
            Voltar aos Decks
        </MudButton>
    </MudPaper>
</MudContainer>

@code {
    [Parameter] public Guid SessionId { get; set; }
    [SupplyParameterFromQuery] public int    Reviewed { get; set; }
    [SupplyParameterFromQuery] public double Average  { get; set; }
}