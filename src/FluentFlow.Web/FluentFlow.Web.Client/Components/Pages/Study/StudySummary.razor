@page "/study/summary/{SessionId:guid}"
@inject NavigationManager Nav

<PageTitle>@($"FluentFlow - {Lang["StudySummary.Title"]}")</PageTitle>

<AuthorizeView>
    <Authorized>
        <MudContainer MaxWidth="MaxWidth.Small" Class="mt-8">
            <MudPaper Class="pa-8" Elevation="3">

                <MudText Typo="Typo.h4" Align="Align.Center" Class="mb-6">
                    @Lang["StudySummary.Completed"] 🎉
                </MudText>

                <MudGrid Class="mb-6">
                    <MudItem xs="6">
                        <StatCard Label="@Lang["Sessions.ReviewedCards"]" Value="@Reviewed.ToString()" />
                    </MudItem>
                    <MudItem xs="6">
                        <StatCard Label="@Lang["Sessions.AverageScore"]" Value="@($"{Average:F1}/5")" />
                    </MudItem>
                </MudGrid>

                <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth OnClick="@(() => Nav.NavigateTo("decks"))">
                    @Lang["StudySummary.BackToDecks"]
                </MudButton>
            </MudPaper>
        </MudContainer>
    </Authorized>
    <NotAuthorized>
        <RedirectToLogin />
    </NotAuthorized>
</AuthorizeView>

@code {
    [Parameter] public Guid SessionId { get; set; }
    [SupplyParameterFromQuery] public int    Reviewed { get; set; }
    [SupplyParameterFromQuery] public double Average  { get; set; }
}