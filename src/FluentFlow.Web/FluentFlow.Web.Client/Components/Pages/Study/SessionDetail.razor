@page "/sessions/{Id:guid}"
@inject ApiClient Api
@inject NavigationManager Nav

<PageTitle>@($"FluentFlow - {Lang["Sessions.Detail"]}")</PageTitle>
<AuthorizeView>
    <Authorized>

        @if (_loading)
        {
            <LoadingSpinner />
        }
        else if (_session is null)
        {
            <MudAlert Severity="Severity.Error">@Lang["Sessions.NotFound"]</MudAlert>
        }
        else
        {
            <!-- Header -->
            <MudStack Row AlignItems="AlignItems.Center" Class="mb-2">
                <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" OnClick="@(() => Nav.NavigateTo("/sessions"))" />

                <MudText Typo="Typo.h5">@_session.DeckName</MudText>

                <MudChip T="string" Size="Size.Small" Color="@(_session.Mode == "Listening" ? Color.Primary : Color.Secondary)">
                    @_session.Mode.GetModeLabel()
                </MudChip>
            </MudStack>

            <!-- Data -->
            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-4">
                @_session.StartedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                @if (_session.EndedAt.HasValue)
                {
                    <text> → @_session.EndedAt.Value.ToLocalTime().ToString("HH:mm")</text>
                }
            </MudText>

            <!-- Stats -->
            <MudGrid Class="mb-6">
                <MudItem xs="6" sm="3">
                    <StatCard Label="@Lang["Sessions.ReviewedCards"]" Value="@($"{_session.ReviewedCards}/{_session.TotalCards}")" />
                </MudItem>

                <MudItem xs="6" sm="3">
                    <StatCard Label="@Lang["Sessions.AverageScore"]" Value="@($"{_session.AverageScore:F1}/5")" />
                </MudItem>

                <MudItem xs="6" sm="3">
                    <StatCard Label="@Lang["Sessions.Duration"]" Value="@FormatDuration(_session.Duration)" />
                </MudItem>

                <MudItem xs="6" sm="3">
                    <StatCard Label="@Lang["Sessions.AccuracyRate"]" Value="@($"{AccuracyRate(_session.Reviews)}%")" />
                </MudItem>
            </MudGrid>

            <!-- Distribuição de scores -->
            @if (_session.Reviews.Any())
            {
                <MudText Typo="Typo.h6" Class="mb-3">@Lang["Sessions.ScoreDistribution"]</MudText>

                <MudPaper Class="pa-4 mb-6" Elevation="1">
                    <MudGrid>
                        @foreach (var g in ScoreGroups(_session.Reviews))
                        {
                            <MudItem xs="4" sm="2">
                                <MudStack AlignItems="AlignItems.Center" Spacing="1">
                                    <MudText Typo="Typo.h6" Style="@($"color:{ScoreColor(g.Score)}")">
                                        @g.Count
                                    </MudText>

                                    <MudText Typo="Typo.caption">
                                        @Lang["Sessions.Score"] @g.Score
                                    </MudText>

                                    <MudProgressLinear Value="@(g.Percent)" Color="@ScoreMudColor(g.Score)" Rounded Size="Size.Small" Style="width:100%" />
                                </MudStack>
                            </MudItem>
                        }
                    </MudGrid>
                </MudPaper>
            }

            <!-- Lista de reviews -->
            <MudText Typo="Typo.h6" Class="mb-3">
                @Lang["Sessions.ReviewedCards"] (@_session.Reviews.Count)
            </MudText>

            <MudTable Items="_session.Reviews" Hover Dense Breakpoint="Breakpoint.Sm" Elevation="1">
                <HeaderContent>
                    <MudTh>@Lang["Sessions.Card"]</MudTh>
                    <MudTh>@Lang["Sessions.Level"]</MudTh>
                    <MudTh>@Lang["Sessions.Score"]</MudTh>
                    <MudTh>@Lang["Sessions.Interval"]</MudTh>
                    <MudTh>@Lang["Sessions.Transcription"]</MudTh>
                </HeaderContent>

                <RowTemplate Context="cardContext">

                    <!-- Card -->
                    <MudTd DataLabel="@Lang["Sessions.Card"]">
                        <MudStack Spacing="0">
                            <MudText Typo="Typo.body2" Style="font-weight:600">
                                @cardContext.CardFront
                            </MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                @cardContext.CardBack
                            </MudText>
                        </MudStack>
                    </MudTd>

                    <!-- Nível -->
                    <MudTd DataLabel="@Lang["Sessions.Level"]">
                        @if (cardContext.CefrLevel is not null)
                        {
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Style="@($"color:{CefrColor(cardContext.CefrLevel)};border-color:{CefrColor(cardContext.CefrLevel)}")">
                                @cardContext.CefrLevel
                            </MudChip>
                        }
                    </MudTd>

                    <!-- Score -->
                    <MudTd DataLabel="@Lang["Sessions.Score"]">
                        <MudChip T="string" Size="Size.Small" Style="@($"background:{ScoreColor(cardContext.Score)}22;color:{ScoreColor(cardContext.Score)};font-weight:600")">
                            @cardContext.Score — @cardContext.ScoreLabel
                        </MudChip>
                    </MudTd>

                    <!-- Intervalo -->
                    <MudTd DataLabel="@Lang["Sessions.Interval"]">
                        <MudText Typo="Typo.caption">
                            @cardContext.PreviousInterval d → @cardContext.NewInterval d
                        </MudText>
                    </MudTd>

                    <!-- Transcrição -->
                    <MudTd DataLabel="@Lang["Sessions.Transcription"]">
                        @if (cardContext.TranscribedText is not null)
                        {
                            <MudStack Spacing="0">
                                <MudText Typo="Typo.caption" Style="font-style:italic">
                                    "@cardContext.TranscribedText"
                                </MudText>

                                @if (cardContext.SimilarityScore.HasValue)
                                {
                                    <MudText Typo="Typo.caption" Style="@($"color:{ScoreColor((int)(cardContext.SimilarityScore.Value * 5))}")">
                                        @((cardContext.SimilarityScore.Value * 100).ToString("F0"))%
                                        @Lang["Sessions.Similarity"]
                                    </MudText>
                                }
                            </MudStack>
                        }
                        else
                        {
                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                @Lang["Sessions.NoTranscription"]
                            </MudText>
                        }
                    </MudTd>

                </RowTemplate>
            </MudTable>
        }
    </Authorized>

    <NotAuthorized>
        <RedirectToLogin />
    </NotAuthorized>
</AuthorizeView>
@code {
    [Parameter] public Guid Id { get; set; }

    private StudySessionDetailDto? _session;
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        var data = await Api.GetSessionDetailAsync(Id);
        _session = data;
        _loading = false;
    }
    
    private string ModeLabel(string mode)
    {
        var res = "";
        switch (mode)
        {
            case "Listening":
                res = $"🎧 {Lang["Study.Listening"]}";
                break;
            case "Speaking":
                res = $"🗣️ {Lang["Study.Speaking"]}";
                break;
        }

        return res;
    }

    private static string FormatDuration(TimeSpan? d) =>
        d is null ? "—"
        : d.Value.TotalMinutes >= 1
            ? $"{(int)d.Value.TotalMinutes}m {d.Value.Seconds}s"
            : $"{d.Value.Seconds}s";

    private static int AccuracyRate(IReadOnlyList<StudyReviewDto> reviews) =>
        reviews.Any()
            ? (int)(reviews.Count(r => r.Score >= 3) * 100.0 / reviews.Count)
            : 0;

    private record ScoreGroup(int Score, int Count, double Percent);

    private static IEnumerable<ScoreGroup> ScoreGroups(IReadOnlyList<StudyReviewDto> reviews)
    {
        for (var i = 0; i <= 5; i++)
        {
            var count = reviews.Count(r => r.Score == i);
            yield return new ScoreGroup(i, count,
                reviews.Any() ? count * 100.0 / reviews.Count : 0);
        }
    }

    private static string ScoreColor(int score) => score >= 4 ? "#4CAF50" : score >= 2 ? "#FF9800" : "#F44336";

    private static Color ScoreMudColor(int score) =>
        score >= 4 ? Color.Success
        : score >= 2 ? Color.Warning
        : Color.Error;

    private static string CefrColor(string? level) => level switch
    {
        "A1" => "#4CAF50", "A2" => "#8BC34A",
        "B1" => "#FFC107", "B2" => "#FF9800",
        "C1" => "#F44336", "C2" => "#9C27B0",
        _    => "#9E9E9E"
    };
}