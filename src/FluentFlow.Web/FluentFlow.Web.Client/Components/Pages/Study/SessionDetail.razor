@page "/sessions/{Id:guid}"
@attribute [Authorize]
@inject ApiClient Api
@inject NavigationManager Nav

<PageTitle>Detalhe da Sessão</PageTitle>

@if (_loading)
{
    <LoadingSpinner />
}
else if (_session is null)
{
    <MudAlert Severity="Severity.Error">Sessão não encontrada.</MudAlert>
}
else
{
    <MudStack Row AlignItems="AlignItems.Center" Class="mb-2">
        <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" OnClick="@(() => Nav.NavigateTo("/sessions"))" />
        <MudText Typo="Typo.h5">@_session.DeckName</MudText>
        <MudChip T="string" Size="Size.Small" Color="@(_session.Mode == "Listening" ? Color.Primary : Color.Secondary)">
            @(_session.Mode == "Listening" ? "🎧" : "🗣️") @_session.Mode
        </MudChip>
    </MudStack>

    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-4">
        @_session.StartedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
        @if (_session.EndedAt.HasValue)
        {
            <text> → @_session.EndedAt.Value.ToLocalTime().ToString("HH:mm")</text>
        }
    </MudText>

    <!-- Stats -->
    <MudGrid Class="mb-6">
        <MudItem xs="6" sm="3">
            <StatCard Label="Cards revistos" Value="@($"{_session.ReviewedCards}/{_session.TotalCards}")" />
        </MudItem>
        <MudItem xs="6" sm="3">
            <StatCard Label="Score médio" Value="@($"{_session.AverageScore:F1}/5")" />
        </MudItem>
        <MudItem xs="6" sm="3">
            <StatCard Label="Duração" Value="@FormatDuration(_session.Duration)" />
        </MudItem>
        <MudItem xs="6" sm="3">
            <StatCard Label="Taxa de acerto" Value="@($"{AccuracyRate(_session.Reviews)}%")" />
        </MudItem>
    </MudGrid>

    <!-- Distribuição de scores -->
    @if (_session.Reviews.Any())
    {
        <MudText Typo="Typo.h6" Class="mb-3">Distribuição de Scores</MudText>
        <MudPaper Class="pa-4 mb-6" Elevation="1">
            <MudGrid>
                @foreach (var g in ScoreGroups(_session.Reviews))
                {
                    <MudItem xs="4" sm="2">
                        <MudStack AlignItems="AlignItems.Center" Spacing="1">
                            <MudText Typo="Typo.h6" Style="@($"color:{ScoreColor(g.Score)}")">
                                @g.Count
                            </MudText>
                            <MudText Typo="Typo.caption">
                                Score @g.Score
                            </MudText>
                            <MudProgressLinear
                                Value="@(g.Percent)"
                                Color="@ScoreMudColor(g.Score)"
                                Rounded Size="Size.Small"
                                Style="width:100%" />
                        </MudStack>
                    </MudItem>
                }
            </MudGrid>
        </MudPaper>
    }

    <!-- Lista de reviews -->
    <MudText Typo="Typo.h6" Class="mb-3">
        Cards revistos (@_session.Reviews.Count)
    </MudText>

    <MudTable Items="_session.Reviews" Hover Dense Breakpoint="Breakpoint.Sm" Elevation="1">
        <HeaderContent>
            <MudTh>Card</MudTh>
            <MudTh>Nível</MudTh>
            <MudTh>Score</MudTh>
            <MudTh>Intervalo</MudTh>
            <MudTh>Transcrição</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Card">
                <MudStack Spacing="0">
                    <MudText Typo="Typo.body2" Style="font-weight:600">
                        @context.CardFront
                    </MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                        @context.CardBack
                    </MudText>
                </MudStack>
            </MudTd>
            <MudTd DataLabel="Nível">
                @if (context.CefrLevel is not null)
                {
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Style="@($"color:{CefrColor(context.CefrLevel)};border-color:{CefrColor(context.CefrLevel)}")">
                        @context.CefrLevel
                    </MudChip>
                }
            </MudTd>
            <MudTd DataLabel="Score">
                <MudChip T="string" Size="Size.Small" Style="@($"background:{ScoreColor(context.Score)}22;color:{ScoreColor(context.Score)};font-weight:600")">
                    @context.Score
                    @* @context.Score — @context.ScoreLabel *@
                </MudChip>
            </MudTd>
            <MudTd DataLabel="Intervalo">
                <MudText Typo="Typo.caption">
                    @context.PreviousInterval d → @context.NewInterval d
                </MudText>
            </MudTd>
            <MudTd DataLabel="Transcrição">
                @if (context.TranscribedText is not null)
                {
                    <MudStack Spacing="0">
                        <MudText Typo="Typo.caption" Style="font-style:italic">
                            "@context.TranscribedText"
                        </MudText>
                        @if (context.SimilarityScore.HasValue)
                        {
                            <MudText Typo="Typo.caption" Style="@($"color:{ScoreColor((int)(context.SimilarityScore.Value * 5))}")">
                                @((context.SimilarityScore.Value * 100).ToString("F0"))% similaridade
                            </MudText>
                        }
                    </MudStack>
                }
                else
                {
                    <MudText Typo="Typo.caption" Color="Color.Secondary">—</MudText>
                }
            </MudTd>
        </RowTemplate>
    </MudTable>
}

@code {
    [Parameter] public Guid Id { get; set; }

    private StudySessionDetailDto? _session;
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        var data = await Api.GetSessionDetailAsync(Id);
        _session = data;
        _loading = false;
    }

    private static string FormatDuration(TimeSpan? d) =>
        d is null ? "—"
        : d.Value.TotalMinutes >= 1
            ? $"{(int)d.Value.TotalMinutes}m {d.Value.Seconds}s"
            : $"{d.Value.Seconds}s";

    private static int AccuracyRate(IReadOnlyList<StudyReviewDto> reviews) =>
        reviews.Any()
            ? (int)(reviews.Count(r => r.Score >= 3) * 100.0 / reviews.Count)
            : 0;

    private record ScoreGroup(int Score, int Count, double Percent);

    private static IEnumerable<ScoreGroup> ScoreGroups(IReadOnlyList<StudyReviewDto> reviews)
    {
        for (var i = 0; i <= 5; i++)
        {
            var count = reviews.Count(r => r.Score == i);
            yield return new ScoreGroup(i, count,
                reviews.Any() ? count * 100.0 / reviews.Count : 0);
        }
    }

    private static string ScoreColor(int score) => score >= 4 ? "#4CAF50" : score >= 2 ? "#FF9800" : "#F44336";

    private static Color ScoreMudColor(int score) =>
        score >= 4 ? Color.Success
        : score >= 2 ? Color.Warning
        : Color.Error;

    private static string CefrColor(string? level) => level switch
    {
        "A1" => "#4CAF50", "A2" => "#8BC34A",
        "B1" => "#FFC107", "B2" => "#FF9800",
        "C1" => "#F44336", "C2" => "#9C27B0",
        _    => "#9E9E9E"
    };
}