@page "/decks/{DeckId:guid}/study"
@using FluentFlow.Core.DTOs
@using FluentFlow.Core.Enums
@using FluentFlow.Web.Client.Services
@using FluentFlow.Web.Client.Shared
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inject ApiClient Api
@inject NavigationManager Nav

<PageTitle>Sessão de Estudo</PageTitle>

@if (_loading)
{
    <LoadingSpinner />
}
else if (_plan is null || _plan.Cards.Count == 0)
{
    <MudAlert Severity="Severity.Success" Class="mt-4">
        Não há cards para rever hoje. Volte amanhã!
    </MudAlert>
    <MudButton Class="mt-4" OnClick="@(() => Nav.NavigateTo("decks"))">
        Voltar aos Decks
    </MudButton>
}
else
{
    <MudText Typo="Typo.h5" Class="mb-2">Sessão de Estudo</MudText>

    <MudChipSet Class="mb-4">
        <MudChip Color="Color.Info"    Text="@($"Novas: {_plan.NewCards}")" />
        <MudChip Color="Color.Warning" Text="@($"Revisão: {_plan.ReviewCards}")" />
        <MudChip Color="Color.Error"   Text="@($"Atrasadas: {_plan.OverdueCards}")" />
    </MudChipSet>

    <MudButtonGroup Variant="Variant.Outlined" Class="mb-6">
        <MudButton Color="_mode == StudyMode.Listening ? Color.Primary : Color.Default"
                   OnClick="() => SetMode(StudyMode.Listening)">
            Listening
        </MudButton>
        <MudButton Color="_mode == StudyMode.Speaking ? Color.Primary : Color.Default"
                   OnClick="() => SetMode(StudyMode.Speaking)">
            Speaking
        </MudButton>
    </MudButtonGroup>

    <MudButton Variant="Variant.Filled" Color="Color.Primary"
               Size="Size.Large" OnClick="StartSessionAsync">
        Iniciar (@_plan.Cards.Count cards)
    </MudButton>
}

@code {
    [Parameter] public Guid DeckId { get; set; }

    private StudyPlanDto? _plan;
    private StudyMode _mode = StudyMode.Listening;
    private bool _loading = true;

    protected override async Task OnInitializedAsync() => await LoadPlanAsync();

    private async Task LoadPlanAsync()
    {
        _loading = true;
        _plan    = await Api.GetPlanAsync(DeckId, _mode);
        _loading = false;
    }

    private async Task SetMode(StudyMode mode)
    {
        _mode = mode;
        await LoadPlanAsync();
    }

    private async Task StartSessionAsync()
    {
        var sessionId = await Api.StartSessionAsync(
            new StartSessionDto(DeckId, _mode));

        if (sessionId.HasValue)
            Nav.NavigateTo($"/study/{sessionId}/{DeckId}/{_mode}");
    }
}