@page "/decks/{DeckId:guid}/study"
@inject ApiClient Api
@inject NavigationManager Nav
@inject ISnackbar Snackbar

<PageTitle>@($"FluentFlow - {Lang["Sessions.Title"]}")</PageTitle>
<AuthorizeView>
    <Authorized>

        @if (_loading)
        {
            <LoadingSpinner />
        }
        else if (_plan is null || _plan.Cards.Count == 0)
        {
            <MudAlert Severity="Severity.Success" Class="mt-4">
                @Lang["StudyPlan.NoCardsToday"]
            </MudAlert>

            <MudButton Class="mt-4" OnClick="@(() => Nav.NavigateTo("decks"))">
                @Lang["StudyPlan.BackToDecks"]
            </MudButton>
        }
        else
        {
            <MudText Typo="Typo.h5" Class="mb-2">
                @Lang["StudyPlan.Title"]
            </MudText>

            <MudChipSet T="string" Class="mb-4">
                <MudChip T="string" Color="Color.Info" Text="@($"{Lang["StudyPlan.NewCards"]}: {_plan.NewCards}")" />
                <MudChip T="string" Color="Color.Warning" Text="@($"{Lang["StudyPlan.ReviewCards"]}: {_plan.ReviewCards}")" />
                <MudChip T="string" Color="Color.Error" Text="@($"{Lang["StudyPlan.OverdueCards"]}: {_plan.OverdueCards}")" />
            </MudChipSet>

            <MudChipSet T="StudyMode"
                        SelectionMode="SelectionMode.SingleSelection"
                        SelectedValue="_mode"
                        SelectedValueChanged="SetMode"
                        CheckMark
                        Class="mb-6">

                <MudChip Value="StudyMode.Listening" Variant="Variant.Outlined" Color="Color.Primary">
                    @Lang["StudyPlan.ModeListening"]
                </MudChip>

                <MudChip Value="StudyMode.Speaking" Variant="Variant.Outlined" Color="Color.Secondary">
                    @Lang["StudyPlan.ModeSpeaking"]
                </MudChip>

            </MudChipSet>

            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large" OnClick="StartSessionAsync">
                @Lang["StudyPlan.Start"] (@_plan.Cards.Count @Lang["Decks.Cards"])
            </MudButton>
        }

    </Authorized>

    <NotAuthorized>
        <RedirectToLogin />
    </NotAuthorized>
</AuthorizeView>

@code {
    [Parameter] public Guid DeckId { get; set; }

    private StudyPlanDto? _plan;
    private StudyMode _mode = StudyMode.Listening;
    private bool _loading = true;

    protected override async Task OnInitializedAsync() => await LoadPlanAsync();

    private async Task LoadPlanAsync()
    {
        _loading = true;
        _plan    = await Api.GetPlanAsync(DeckId, _mode);
        _loading = false;
    }

    private async Task SetMode(StudyMode mode)
    {
        _mode = mode;
        await LoadPlanAsync();
    }

    private async Task StartSessionAsync()
    {
        var result = await Api.StartSessionAsync(new StartSessionDto(DeckId, _mode));

        if (result.Success)
            Nav.NavigateTo($"/study/{result.Value}/{DeckId}/{_mode}");
        else
            Snackbar.Add(result.Error, Severity.Error);
    }
}