@page "/decks/{DeckId:guid}/study"
@inject ApiClient Api
@inject NavigationManager Nav
@inject ISnackbar Snackbar

<PageTitle>@($"FluentFlow - {Lang["Sessions.Title"]}")</PageTitle>
<AuthorizeView>
    <Authorized>

        <MudText Typo="Typo.h5" Class="mb-4">
            @Lang["StudyPlan.Title"]
        </MudText>

        <!-- Selector de modo — sempre visível -->
        <MudChipSet T="StudyMode"
                    SelectionMode="SelectionMode.SingleSelection"
                    SelectedValue="_mode"
                    SelectedValueChanged="SetMode"
                    CheckMark
                    Class="mb-6">
            <MudChip Value="StudyMode.Listening" Variant="Variant.Outlined" Color="Color.Primary">
                @Lang["StudyPlan.ModeListening"]
            </MudChip>
            <MudChip Value="StudyMode.Speaking" Variant="Variant.Outlined" Color="Color.Secondary">
                @Lang["StudyPlan.ModeSpeaking"]
            </MudChip>
        </MudChipSet>

        @if (!_loading && _resumable is not null)
        {
            <MudAlert Severity="Severity.Info" Class="mb-4">
                <div class="d-flex align-center flex-wrap gap-2">
                    <span>
                        @Lang["StudyPlan.ResumableFound"]
                        (@_resumable.ReviewedCards @Lang["Decks.Cards"] —
                        @_resumable.StartedAt.ToLocalTime().ToString("dd/MM HH:mm"))
                    </span>
                    <MudButton Variant="Variant.Filled" Color="Color.Info" Size="Size.Small"
                               OnClick="ResumeSessionAsync">
                        @Lang["StudyPlan.Resume"]
                    </MudButton>
                </div>
            </MudAlert>
        }

        @if (_loading)
        {
            <LoadingSpinner />
        }
        else if (_plan is null || _plan.Cards.Count == 0)
        {
            <MudAlert Severity="Severity.Success" Class="mt-2">
                @Lang["StudyPlan.NoCardsToday"]
            </MudAlert>

            <MudButton Class="mt-4" OnClick="@(() => Nav.NavigateTo("decks"))">
                @Lang["StudyPlan.BackToDecks"]
            </MudButton>
        }
        else
        {
            <MudChipSet T="string" Class="mb-4">
                <MudChip T="string" Color="Color.Info"
                         Text="@($"{Lang["StudyPlan.NewCards"]}: {_plan.NewCards}")" />
                <MudChip T="string" Color="Color.Warning"
                         Text="@($"{Lang["StudyPlan.ReviewCards"]}: {_plan.ReviewCards}")" />
                <MudChip T="string" Color="Color.Error"
                         Text="@($"{Lang["StudyPlan.OverdueCards"]}: {_plan.OverdueCards}")" />
            </MudChipSet>

            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                       Size="Size.Large" OnClick="StartSessionAsync">
                @Lang["StudyPlan.Start"] (@_plan.Cards.Count @Lang["Decks.Cards"])
            </MudButton>
        }

    </Authorized>

    <NotAuthorized>
        <RedirectToLogin />
    </NotAuthorized>
</AuthorizeView>

@code {
    [Parameter] public Guid DeckId { get; set; }

    private StudyPlanDto?         _plan;
    private ResumableSessionDto?  _resumable;
    private StudyMode             _mode    = StudyMode.Listening;
    private bool                  _loading = true;

    protected override async Task OnInitializedAsync() => await LoadPlanAsync();

    private async Task LoadPlanAsync()
    {
        _loading = true;

        // Carregar o plano e verificar se há uma sessão por terminar em paralelo
        var planTask      = Api.GetPlanAsync(DeckId, _mode);
        var resumableTask = Api.GetResumableSessionAsync(DeckId, _mode);
        await Task.WhenAll(planTask, resumableTask);

        _plan      = planTask.Result;
        _resumable = resumableTask.Result;
        _loading   = false;
    }

    private async Task SetMode(StudyMode mode)
    {
        if (_mode == mode) return; // evitar reload desnecessário
        _mode = mode;
        await LoadPlanAsync();
    }

    private async Task StartSessionAsync()
    {
        var result = await Api.StartSessionAsync(new StartSessionDto(DeckId, _mode));

        if (result.Success)
            Nav.NavigateTo($"/study/{result.Value}/{DeckId}/{_mode}");
        else
            Snackbar.Add(result.Error, Severity.Error);
    }

    private void ResumeSessionAsync()
    {
        if (_resumable is null) return;
        Nav.NavigateTo($"/study/{_resumable.SessionId}/{DeckId}/{_mode}");
    }
}