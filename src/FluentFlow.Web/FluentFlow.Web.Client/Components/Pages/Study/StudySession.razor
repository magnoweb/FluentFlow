@page "/study/{SessionId:guid}/{DeckId:guid}/{Mode}"
@inject ApiClient Api
@inject NavigationManager Nav
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@inject IDialogService DialogService
@implements IAsyncDisposable

<PageTitle>@($"FluentFlow - {Lang["StudySession.Title"]}")</PageTitle>

<AuthorizeView>
    <Authorized>

        @if (_loading)
        {
            <LoadingSpinner />
        }
        else if (_currentCard is null)
        {
            <LoadingSpinner />
        }
        else
        {
            <!-- Header -->
            <MudStack Row AlignItems="AlignItems.Center" Class="mb-2">
                <MudText Typo="Typo.caption">
                    @_reviewedCount / @_totalCards @Lang["Decks.Cards"]
                </MudText>

                <MudSpacer />

                <MudButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small" StartIcon="@Icons.Material.Filled.Stop" OnClick="EndSessionAsync">
                    @Lang["StudySession.EndSession"]
                </MudButton>
            </MudStack>

            <MudProgressLinear Value="_progressPercent" Color="Color.Primary" Rounded Size="Size.Medium" Class="mb-6" />

            <!-- Card -->
            <MudPaper Elevation="4" Class="pa-8 mb-4" Style="min-height:180px; cursor:pointer;" @onclick="FlipCard">
                @if (!_flipped)
                {
                    <MudStack AlignItems="AlignItems.Center" Justify="Justify.Center" Style="min-height:120px">
                        <MudText Typo="Typo.h4" Align="Align.Center">
                            @_currentCard.Front
                        </MudText>

                        @if (_studyMode == StudyMode.Listening && !string.IsNullOrEmpty(_currentCard.AudioPath))
                        {
                            <MudStack Row AlignItems="AlignItems.Center" Spacing="1">

                                <!-- Play / Stop -->
                                <MudIconButton Icon="@(_isPlaying ? Icons.Material.Filled.Stop : Icons.Material.Filled.PlayArrow)"
                                               Color="@(_isPlaying ? Color.Error : Color.Primary)"
                                               Size="Size.Large"
                                               OnClick="PlayAudioAsync"
                                               Title="@(_isPlaying  ? Lang["StudySession.Stop"] : Lang["StudySession.Play"])" />

                                <!-- Selector de velocidade -->
                                <MudStack Spacing="0" AlignItems="AlignItems.Center">
                                    <MudText Typo="Typo.caption" Color="Color.Secondary" Style="font-size:10px; opacity:0.7; margin-bottom:2px">
                                        @Lang["StudySession.Speed"]
                                    </MudText>
                                    <MudButtonGroup Variant="Variant.Outlined" Size="Size.Small" OverrideStyles="false">
                                        @foreach (var rate in SpeedOptions)
                                        {
                                            <MudButton Color="@(_playbackRate == rate ? Color.Primary : Color.Default)"
                                                       Variant="@(_playbackRate == rate ? Variant.Filled : Variant.Outlined)"
                                                       OnClick="() => SetSpeedAsync(rate)"
                                                       Style="min-width:44px; padding: 0 6px">
                                                @($"{rate:0.##}×")
                                            </MudButton>
                                        }
                                    </MudButtonGroup>
                                </MudStack>
                            </MudStack>
                        }

                        <!-- Hint de teclado — Listening -->
                        @if (_studyMode == StudyMode.Listening)
                        {
                            <MudStack Row Justify="Justify.Center" Spacing="3" Class="mt-2">
                                <MudText Typo="Typo.caption" Color="Color.Secondary" Style="opacity:0.5">
                                    ↑↓ @Lang["Study.KeyHintFlip"]
                                </MudText>
                                @if (!string.IsNullOrEmpty(_currentCard.AudioPath))
                                {
                                    <MudText Typo="Typo.caption" Color="Color.Secondary" Style="opacity:0.5">
                                        ←→ @Lang["Study.KeyHintReplay"]
                                    </MudText>
                                }
                                <MudText Typo="Typo.caption" Color="Color.Secondary" Style="opacity:0.5">
                                    ⎵ @Lang["Study.KeyHintFlip"]
                                </MudText>
                            </MudStack>
                        }

                        <!-- Hint de teclado — Speaking (antes de gravar) -->
                        @if (_studyMode == StudyMode.Speaking && !_recording && !_transcribing)
                        {
                            <MudStack Row Justify="Justify.Center" Spacing="3" Class="mt-2">
                                <MudText Typo="Typo.caption" Color="Color.Secondary" Style="opacity:0.5">
                                    ↑↓ @Lang["Study.KeyHintFlip"]
                                </MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary" Style="opacity:0.5">
                                    ⎵ @Lang["Study.KeyHintRecord"]
                                </MudText>
                            </MudStack>
                        }
                    </MudStack>
                }
                else
                {
                    <MudStack AlignItems="AlignItems.Center" Justify="Justify.Center" Style="min-height:120px">
                        <MudText Typo="Typo.h4" Align="Align.Center" Color="Color.Primary">
                            @_currentCard.Back
                        </MudText>

                        @if (_currentCard.Pronunciation is not null)
                        {
                            <MudText Typo="Typo.body1" Align="Align.Center" Class="mt-1">
                                [@_currentCard.Pronunciation]
                            </MudText>
                        }
                    </MudStack>
                }
            </MudPaper>

            <!-- Speaking Mode -->
            @if (_studyMode == StudyMode.Speaking)
            {
                <MudPaper Elevation="1" Class="pa-4 mb-4">
                    <MudStack AlignItems="AlignItems.Center" Spacing="3">
                        @if (!_recording && (!_transcribing && _transcribedText is null))
                        {
                            <MudText Typo="Typo.subtitle2">
                                @Lang["StudySession.SayWord"]
                            </MudText>

                            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Mic" OnClick="StartRecordingAsync">
                                @Lang["StudySession.Record"]
                            </MudButton>
                        }
                        else if (_recording)
                        {
                            <MudStack AlignItems="AlignItems.Center" Spacing="2">
                                <MudProgressCircular Color="Color.Error" Indeterminate Size="Size.Small" />
                                <MudText Typo="Typo.caption" Color="Color.Error">
                                    @Lang["StudySession.Recording"] (@_recordingSeconds s)
                                </MudText>

                                <MudButton Variant="Variant.Filled" Color="Color.Error" StartIcon="@Icons.Material.Filled.Stop" OnClick="StopRecordingAsync">
                                    @Lang["StudySession.Stop"]
                                </MudButton>
                                <MudText Typo="Typo.caption" Color="Color.Secondary" Style="opacity:0.5">
                                    ⎵ @Lang["Study.KeyHintRecord"]
                                </MudText> 
                            </MudStack>
                        }
                        else if (_transcribing)
                        {
                            <MudStack AlignItems="AlignItems.Center" Spacing="2">
                                <MudProgressCircular Color="Color.Primary" Indeterminate Size="Size.Small" />
                                <MudText Typo="Typo.caption">
                                    @Lang["StudySession.Transcribing"]
                                </MudText>
                            </MudStack>
                        }
                        else if (_transcribedText is not null)
                        {
                            <MudStack AlignItems="AlignItems.Center" Spacing="2" Style="width:100%">
                                <MudStack Row Justify="Justify.SpaceBetween" Style="width:100%">
                                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                                        @Lang["StudySession.YouSaid"]
                                    </MudText>

                                    <MudChip T="string" Color="@SimilarityColor" Size="Size.Small">
                                        @Lang["Sessions.Similarity"]: @(_similarityPercent)%
                                    </MudChip>
                                </MudStack>

                                <MudPaper Outlined Class="pa-3" Style="width:100%">
                                    <MudText Typo="Typo.body1" Align="Align.Center">
                                        @_transcribedText
                                    </MudText>
                                </MudPaper>

                                <MudProgressLinear Value="@_similarityPercent" Color="@SimilarityColor" Rounded Size="Size.Medium" Style="width:100%" />

                                <MudButton Variant="Variant.Text" Size="Size.Small" StartIcon="@Icons.Material.Filled.Refresh" OnClick="ResetRecording">
                                    @Lang["StudySession.TryAgain"]
                                </MudButton>
                            </MudStack> 
                        }
                    </MudStack>
                </MudPaper>
            }

            <!-- Scores -->
            @if (_flipped || (Mode == "Speaking" && !string.IsNullOrEmpty(_transcribedText)))
            {
                <MudStack Row AlignItems="AlignItems.Center" Class="mb-2">
                    <MudText Typo="Typo.subtitle1">
                        @Lang["StudySession.HowDidItGo"]
                    </MudText>
                    <MudSpacer />
                    <!-- Hint de teclado para scores -->
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Style="opacity:0.5">
                        0–5 @Lang["Study.KeyHintScore"]
                        @if (_pendingScore.HasValue)
                        {
                            <span> &nbsp;·&nbsp; ↵ @Lang["Study.KeyHintConfirm"]</span>
                        }
                    </MudText>
                </MudStack>

                <MudGrid>
                    @foreach (var (label, score, color) in ScoreOptions)
                    {
                        var isSelected = _pendingScore == score;
                        <MudItem xs="4" sm="2">
                            <MudButton Variant="@(isSelected ? Variant.Filled : Variant.Outlined)"
                                       Color="@color" FullWidth Disabled="_submitting"
                                       Style="@(isSelected ? "box-shadow: 0 0 0 3px var(--mud-palette-primary);" : "")"
                                       OnClick="() => SubmitReviewAsync(score)">
                                <!-- Número da tecla pequeno + label -->
                                <MudStack Row AlignItems="AlignItems.Center" Justify="Justify.Center" Spacing="1">
                                    <MudText Typo="Typo.caption" Style="opacity:0.55; font-size:10px; min-width:12px">
                                        @score
                                    </MudText>
                                    <span>@label</span>
                                </MudStack>
                            </MudButton>
                        </MudItem>
                    }
                </MudGrid>
            }
        }
    </Authorized>

    <NotAuthorized>
        <RedirectToLogin />
    </NotAuthorized>
</AuthorizeView>

@code {
    [Parameter] public Guid SessionId { get; set; }
    [Parameter] public Guid DeckId { get; set; }
    [Parameter] public string Mode { get; set; } = "Listening";

    private StudyMode _studyMode;
    private List<CardDto> _cards = [];
    private CardDto? _currentCard;
    private bool _flipped;
    private bool _loading = true;
    private bool _submitting;
    private int _reviewedCount;
    private int _totalCards;

    // Speaking
    private bool _recording;
    private bool _transcribing;
    private int _recordingSeconds;
    private string? _transcribedText;
    private double _similarityRatio;
    private Timer? _recordingTimer;

    // Teclado
    private int? _pendingScore;
    private DotNetObjectReference<StudySession>? _dotNetRef;

    // Áudio
    private bool _isPlaying;
    private double _playbackRate = 1.0;
    private static readonly double[] SpeedOptions = [0.5, 0.75, 1.0];

    private int _similarityPercent => (int)(_similarityRatio * 100);
    private double _progressPercent => _totalCards > 0 ? (_reviewedCount / (double)_totalCards) * 100 : 0;

    private Color SimilarityColor => _similarityPercent switch
    {
        >= 85 => Color.Success,
        >= 60 => Color.Warning,
        _     => Color.Error
    };

    private static readonly (string Label, int Score, Color Color)[] ScoreOptions =
    [
        ("Nada (0)", 0, Color.Error),
        ("Errei (1)", 1, Color.Error),
        ("Difícil (2)", 2, Color.Warning),
        ("Ok (3)", 3, Color.Warning),
        ("Bem (4)", 4, Color.Success),
        ("Fácil (5)", 5, Color.Success),
    ];

    // ── Lifecycle ──────────────────────────────────────────────────────────────
    protected override async Task OnInitializedAsync()
    {
        _studyMode = Enum.Parse<StudyMode>(Mode);

        var plan = await Api.GetPlanAsync(DeckId, _studyMode);
        if (plan is null || plan.Cards.Count == 0)
        {
            Nav.NavigateTo("/decks");
            return;
        }

        _cards = plan.Cards.ToList();
        _totalCards = _cards.Count;
        _currentCard = _cards.First();
        _loading = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        // Criar referência .NET antes de qualquer uso (teclado + áudio)
        _dotNetRef = DotNetObjectReference.Create(this);

        // Auto-play primeiro card (Listening)
        if (_studyMode == StudyMode.Listening && _currentCard?.AudioPath is not null)
            await PlayAudioAsync();

        // Registar atalhos de teclado
        await JS.InvokeVoidAsync("FluentFlow.registerKeyboard", _dotNetRef);
    }

    // ── Audio (Listening) ──────────────────────────────────────────────────────
    private async Task PlayAudioAsync()
    {
        if (_currentCard?.AudioPath is null) return;

        // Se já está a tocar — parar
        if (_isPlaying)
        {
            await JS.InvokeVoidAsync("FluentFlow.studyStop");
            _isPlaying = false;
            StateHasChanged();
            return;
        }

        try
        {
            var url = Api.GetAudioUrl(_currentCard.AudioPath);
            await JS.InvokeVoidAsync("FluentFlow.studyPlay", url, _dotNetRef, _playbackRate);
            _isPlaying = true;
            StateHasChanged();
        }
        catch { /* ignorar */ }
    }

    private async Task SetSpeedAsync(double rate)
    {
        _playbackRate = rate;

        // Se está a tocar, reiniciar com a nova velocidade
        if (_isPlaying && _currentCard?.AudioPath is not null)
        {
            await JS.InvokeVoidAsync("FluentFlow.studyStop");
            _isPlaying = false;
            await PlayAudioAsync();
        }

        StateHasChanged();
    }

    /// <summary>Callback chamado pelo JS quando o áudio termina</summary>
    [JSInvokable]
    public void OnStudyAudioEnded()
    {
        _isPlaying = false;
        InvokeAsync(StateHasChanged);
    }

    // ── Recording (Speaking) ───────────────────────────────────────────────────
    private async Task StartRecordingAsync()
    {
        _recording = true;
        _recordingSeconds = 0;
        _transcribedText = null;
        _similarityRatio = 0;

        // Timer para mostrar segundos a gravar
        _recordingTimer = new Timer(
            async _ =>
            {
                _recordingSeconds++;
                await InvokeAsync(StateHasChanged);

                // Parar automaticamente após 30 segundos
                if (_recordingSeconds >= 30)
                    await InvokeAsync(StopRecordingAsync);
            },
            null,
            TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(1));

        await JS.InvokeVoidAsync("FluentFlow.startRecording");
    }

    private async Task StopRecordingAsync()
    {
        _recordingTimer?.Dispose();
        _recordingTimer = null;
        _recording = false;
        _transcribing = true;
        StateHasChanged();

        try
        {
            var json = await JS.InvokeAsync<string>("FluentFlow.stopRecording");

            if (string.IsNullOrEmpty(json))
            {
                Snackbar.Add("Nenhum áudio gravado.", Severity.Warning);
                _transcribing = false;
                return;
            }
            
            var payload   = System.Text.Json.JsonSerializer.Deserialize<RecordingPayload>(json);

            if (payload is null || string.IsNullOrEmpty(payload.Base64))
            {
                _transcribing = false;
                return;
            }

            // Passar o texto original do card para cálculo de similaridade
            var result = await Api.TranscribeAudioAsync(payload.Base64, payload.Extension, _currentCard!.Front, _currentCard.DeckId); // deck para obter o idioma

            if (!result.Success)
            {
                Snackbar.Add($"{Lang["Study.ErrorTranscription"]}: {result.Error}", Severity.Error);
                return;
            }

            _transcribedText = result.Value!.TranscribedText;
            _similarityRatio = result.Value.SimilarityRatio;

            // Mostrar o verso automaticamente após transcrição
            _flipped = true;
        }
        catch (Exception ex)
        {
            Snackbar.Add($"{Lang["Study.ErrorProcessingRecording"]}: {ex.Message}", Severity.Error);
        }
        finally
        {
            _transcribing = false;
            StateHasChanged();
        }
    }

    private void ResetRecording()
    {
        _transcribedText = null;
        _similarityRatio = 0;
        _flipped = false;
    }

    // ── Review ─────────────────────────────────────────────────────────────────
    private void FlipCard() => _flipped = !_flipped;

    private async Task SubmitReviewAsync(int score)
    {
        if (_currentCard is null || _submitting) return;
        _submitting = true;
        _pendingScore = null;

        var dto = new SubmitReviewDto(
            SessionId,
            _currentCard.Id,
            score,
            _studyMode == StudyMode.Speaking ? _similarityRatio : null,
            _transcribedText);

        var reviewResult = await Api.SubmitReviewAsync(dto);

        if (!reviewResult.Success)
        {
            Snackbar.Add($"{Lang["Study.ErrorSubmittingReview"]}: {reviewResult.Error}", Severity.Error);
            _submitting = false;
            return;
        }

        _reviewedCount++;
        _cards.Remove(_currentCard);
        _currentCard     = _cards.FirstOrDefault();
        _flipped         = false;
        _transcribedText = null;
        _similarityRatio = 0;
        _submitting      = false;
        _isPlaying       = false; // ← reset ao avançar card

        StateHasChanged();

        // Reproduzir próximo card automaticamente
        if (_currentCard is not null && _studyMode == StudyMode.Listening && _currentCard.AudioPath is not null)
        {
            await Task.Delay(300); // aguardar render
            await PlayAudioAsync();
        }

        if (_currentCard is null)
            await FinishSessionAsync();
    }

    private async Task EndSessionAsync()
    {
        bool? result = await DialogService.ShowMessageBoxAsync(Lang["Logs.Filter.Warning"], Lang["Study.EndSessionConfirm"], yesText:Lang["Common.Continue"], cancelText:Lang["Common.Cancel"]);
        if (result == null) return;
        await FinishSessionAsync();
    }

    private async Task FinishSessionAsync()
    {
        var endResult = await Api.EndSessionAsync(SessionId);

        if (endResult.Success)
        {
            var reviewed = endResult.Value!.ReviewedCards;
            var average  = endResult.Value.AverageScore.ToString("F2", System.Globalization.CultureInfo.InvariantCulture);
            Nav.NavigateTo($"/study/summary/{SessionId}?reviewed={reviewed}&average={average}");
        }
        else
        {
            Snackbar.Add(Lang["Study.SessionEndedWithErrors"], Severity.Warning);
            Nav.NavigateTo("/decks");
        }
    }
    
    // ── Callbacks de teclado (chamados pelo JS) ────────────────────────────────

    /// <summary>↑ / ↓ — virar card</summary>
    [JSInvokable]
    public Task OnFlipPressed()
    {
        if (_recording || _transcribing || _submitting)
            return Task.CompletedTask;

        _flipped = !_flipped;
        StateHasChanged();
        return Task.CompletedTask;
    }

    /// <summary>← / → — repetir áudio (só Listening)</summary>
    [JSInvokable]
    public async Task OnReplayPressed()
    {
        if (_studyMode != StudyMode.Listening) return;
        if (_currentCard?.AudioPath is null)   return;
        if (_recording || _transcribing)       return;

        await PlayAudioAsync();
    }

    /// <summary>
    /// ⎵ Espaço:
    ///   Listening → virar card
    ///   Speaking  → iniciar / parar gravação
    /// </summary>
    [JSInvokable]
    public async Task OnSpacePressed()
    {
        if (_submitting) return;

        if (_studyMode == StudyMode.Speaking)
        {
            if (_transcribing) return; // a transcrever — ignorar

            if (_recording)
                await InvokeAsync(StopRecordingAsync);
            else if (_transcribedText is null && !_flipped)
                await InvokeAsync(StartRecordingAsync);
        }
        else
        {
            // Listening — espaço vira o card
            if (_recording || _transcribing) return;
            _flipped = !_flipped;
            StateHasChanged();
        }
    }

    /// <summary>0–5 — submeter score directamente (sem precisar de Enter)</summary>
    [JSInvokable]
    public async Task OnNumberPressed(int number)
    {
        if (!_flipped || _submitting)  return;
        if (number < 0 || number > 5) return;

        // Speaking: só submeter se a transcrição estiver concluída
        if (_studyMode == StudyMode.Speaking && _transcribedText is null)
        {
            _pendingScore = null;
            return;
        }

        await InvokeAsync(async () => await SubmitReviewAsync(number));
    }

    /// <summary>↵ Enter — confirmar score em modo "dois passos"</summary>
    [JSInvokable]
    public async Task OnEnterPressed()
    {
        if (!_flipped || _submitting || _pendingScore is null) return;

        var score = _pendingScore.Value;
        await InvokeAsync(async () => await SubmitReviewAsync(score));
    }

    public async ValueTask DisposeAsync()
    {
        _recordingTimer?.Dispose();

        if (_recording)
        {
            try { await JS.InvokeVoidAsync("FluentFlow.stopRecording"); }
            catch { /* ignorar */ }
        }

        if (_isPlaying)
        {
            try { await JS.InvokeVoidAsync("FluentFlow.studyStop"); }
            catch { /* ignorar */ }
        }

        try { await JS.InvokeVoidAsync("FluentFlow.unregisterKeyboard"); }
        catch { /* ignorar */ }

        _dotNetRef?.Dispose();
    }
    
    // DTO local para deserializar o payload do JS
    private record RecordingPayload(
        [property: System.Text.Json.Serialization.JsonPropertyName("base64")]
        string Base64,
        [property: System.Text.Json.Serialization.JsonPropertyName("extension")]
        string Extension
    );

}