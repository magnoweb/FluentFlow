@page "/"
@layout EmptyLayout
@inject NavigationManager Nav
@inject ApiClient Api
@inject AuthenticationStateProvider AuthStateProvider
@inject LanguageService LangService

<PageTitle>FluentFlow — @Lang["Home.PageTitle"]</PageTitle>

@if (_checkingAuth)
{
    @* Silencioso — o loading global já está activo *@
}
else if (_isAuthenticated)
{
    @* ═══════════════════════════════════════════════════
        VISTA AUTENTICADA — Dashboard resumido
    ═══════════════════════════════════════════════════ *@
    <div class="ff-auth-home">
        <!-- Header -->
        <header class="ff-header">
            <div class="ff-logo">
                <div class="ff-logo-icon">F</div>
                <span class="ff-logo-text-main">Fluent</span><span class="ff-logo-text-accent">Flow</span>
            </div>
            <nav class="ff-nav">
                <button class="ff-btn-link" @onclick="@(() => Nav.NavigateTo("/decks"))">
                    @Lang["Decks.Title"]
                </button>
            </nav>
        </header>

        <MudContainer MaxWidth="MaxWidth.Large" Class="mt-8">
            <MudText Typo="Typo.h4" Class="mb-1">
                @Lang["Auth.WelcomeBack"], <strong>@_userName</strong>
            </MudText>
            <MudText Typo="Typo.body1" Color="Color.Secondary" Class="mb-6">
                @DateTime.Now.ToString("dddd, d 'de' MMMM", new System.Globalization.CultureInfo(LangService.Current))
            </MudText>

            @if (_loadingDecks)
            {
                <LoadingSpinner />
            }
            else if (_decks is null || _decks.TotalCount == 0)
            {
                <!-- Sem decks — onboarding -->
                <MudPaper Class="pa-8 text-center" Elevation="2" Style="max-width:520px; margin:0 auto;">
                    <MudIcon Icon="@Icons.Material.Filled.LibraryBooks" Style="font-size:3rem; color:var(--mud-palette-primary);" Class="mb-4" />
                    <MudText Typo="Typo.h5" Class="mb-2">@Lang["Decks.NoDecks"]</MudText>
                    <MudText Typo="Typo.body1" Color="Color.Secondary" Class="mb-6">
                        @Lang["Home.InitialMessage"]
                    </MudText>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large" StartIcon="@Icons.Material.Filled.Add" OnClick="@(() => Nav.NavigateTo("/decks"))">
                        @Lang["Home.CreateFirstDeck"]
                    </MudButton>
                </MudPaper>
            }
            else
            {
                <!-- Resumo geral -->
                <MudGrid Class="mb-8">
                    <MudItem xs="6" sm="3">
                        <MudPaper Class="pa-4 text-center" Elevation="1">
                            <MudText Typo="Typo.h4" Color="Color.Primary" Style="font-weight:700">
                                @_decks.TotalCount
                            </MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">@Lang["Common.Decks"]</MudText>
                        </MudPaper>
                    </MudItem>
                    <MudItem xs="6" sm="3">
                        <MudPaper Class="pa-4 text-center" Elevation="1">
                            <MudText Typo="Typo.h4" Color="Color.Warning" Style="font-weight:700">
                                @_totalDueToday
                            </MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">@Lang["Decks.DueToday"]</MudText>
                        </MudPaper>
                    </MudItem>
                    <MudItem xs="6" sm="3">
                        <MudPaper Class="pa-4 text-center" Elevation="1">
                            <MudText Typo="Typo.h4" Color="Color.Success" Style="font-weight:700">
                                @_totalStudiedToday
                            </MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">@Lang["Decks.StudiedToday"]</MudText>
                        </MudPaper>
                    </MudItem>
                    <MudItem xs="6" sm="3">
                        <MudPaper Class="pa-4 text-center" Elevation="1">
                            <MudText Typo="Typo.h4" Color="Color.Info" Style="font-weight:700">
                                @_totalCards
                            </MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">@Lang["Decks.TotalCards"]</MudText>
                        </MudPaper>
                    </MudItem>
                </MudGrid>

                <!-- Decks com actividade -->
                <MudText Typo="Typo.h6" Class="mb-3">@Lang["Decks.YourDecks"]</MudText>
                <MudGrid>
                    @foreach (var item in _deckSummaries)
                    {
                        var d = item;
                        <MudItem xs="12" sm="6" md="4">
                            <MudCard Elevation="2" Style="height:100%">
                                <MudCardContent>
                                    <MudStack Row AlignItems="AlignItems.Center" Class="mb-2">
                                        <MudText Typo="Typo.h6" Style="flex:1">@d.Deck.Name</MudText>
                                        <MudChip T="string" Size="Size.Small" Color="Color.Default">
                                            @d.Deck.Language.ToUpper()
                                        </MudChip>
                                    </MudStack>

                                    @if (d.Dashboard is not null)
                                    {
                                        <MudStack Row Spacing="3" Class="mb-3">
                                            <div>
                                                <MudText Typo="Typo.caption" Color="Color.Secondary">
                                                    @Lang["Decks.ForToday"]
                                                </MudText>
                                                <MudText Typo="Typo.body1" Color="Color.Warning" Style="font-weight:600">
                                                    @d.Dashboard.DueToday
                                                </MudText>
                                            </div>
                                            <div>
                                                <MudText Typo="Typo.caption" Color="Color.Secondary">
                                                    @Lang["Common.New"]
                                                </MudText>
                                                <MudText Typo="Typo.body1" Color="Color.Info" Style="font-weight:600">
                                                    @d.Dashboard.NewToday
                                                </MudText>
                                            </div>
                                            <div>
                                                <MudText Typo="Typo.caption" Color="Color.Secondary">
                                                    @Lang["Common.Total"]
                                                </MudText>
                                                <MudText Typo="Typo.body1" Style="font-weight:600">
                                                    @d.Dashboard.TotalCards
                                                </MudText>
                                            </div>
                                        </MudStack>
                                        
                                        <MudProgressLinear Value="@GetPct(d)" Color="@(@GetPct(d) >= 100 ? Color.Success : Color.Primary)" Rounded="true" Size="Size.Small" Class="mb-1" />
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                                            @(@GetPct(d) >= 100 ? $"✓ {Lang["Common.FullSessionOfDay"]}" : $"{@GetPct(d)}% {Lang["Common.TodaysPlan"]}")
                                        </MudText>
                                    }
                                </MudCardContent>
                                <MudCardActions>
                                    @if (d.Dashboard?.DueToday > 0 || d.Dashboard?.NewToday > 0)
                                    {
                                        <MudButton Color="Color.Primary" Variant="Variant.Filled" Size="Size.Small" StartIcon="@Icons.Material.Filled.School"
                                                   OnClick="@(() => Nav.NavigateTo($"/decks/{d.Deck.Id}/study"))">
                                            @Lang["Common.StudyNow"]
                                        </MudButton>
                                    }
                                    else
                                    {
                                        <MudButton Color="Color.Success" Variant="Variant.Text" Size="Size.Small" StartIcon="@Icons.Material.Filled.CheckCircle" Disabled>
                                            @Lang["Common.UpToDate"]
                                        </MudButton>
                                    }
                                    <MudButton Color="Color.Default" Variant="Variant.Text" Size="Size.Small" OnClick="@(() => Nav.NavigateTo($"/decks/{d.Deck.Id}"))">
                                        @Lang["Common.Details"]
                                    </MudButton>
                                </MudCardActions>
                            </MudCard>
                        </MudItem>
                    }
                </MudGrid>

                <MudStack Row Justify="Justify.Center" Class="mt-6">
                    <MudButton Variant="Variant.Outlined"  StartIcon="@Icons.Material.Filled.LibraryBooks" OnClick="@(() => Nav.NavigateTo("/decks"))">
                        @Lang["Common.ViewAllDecks"]
                    </MudButton>
                </MudStack>
            }
        </MudContainer>
    </div>
}
else
{
    @* ═══════════════════════════════════════════════════
        VISTA ANÓNIMA — Landing page
    ═══════════════════════════════════════════════════ *@
    <MudContainer MaxWidth="MaxWidth.ExtraLarge">
        <header class="ff-header">
            <div class="ff-logo">
                <div class="ff-logo-icon">F</div>
                <span class="ff-logo-text-main">Fluent</span><span class="ff-logo-text-accent">Flow</span>
            </div>

            <div class="ff-header-right">
                <LanguagePicker />
                <button class="ff-btn-link" @onclick="@(() => Nav.NavigateTo("/login"))">
                    @Lang["Auth.Login"]
                </button>

                <button class="ff-btn-primary-small" @onclick="@(() => Nav.NavigateTo("/register"))">
                    @Lang["Auth.Register"]
                </button>
            </div>
        </header>

        <!-- Hero -->
        <div class="ff-hero">
            <div class="ff-hero-left">
                <h1 class="ff-title">@Lang["Home.PageTitle"]</h1>

                <p class="ff-subtitle">
                    @Lang["Home.Subtitle"] 
                </p>

                <div class="ff-actions">
                    <button class="ff-btn-primary" @onclick="@(() => Nav.NavigateTo("/register"))">
                        @Lang["Home.StartNow"] 
                    </button>

                    <button class="ff-btn-outline" @onclick="@(() => Nav.NavigateTo("/login"))">
                        @Lang["Home.AlreadyHaveAccount"] 
                    </button>
                </div>

                <div class="ff-tags">
                    <span>🎧 @Lang["Study.Listening"]</span>
                    <span>🗣️ @Lang["Study.Speaking"]</span>
                    <span>⏱️ SM‑2</span>
                    <span>📊 Dashboards</span>
                </div>
            </div>

            <div class="ff-hero-right">
                <!-- Card de preview animado -->
                <div class="ff-preview-card">
                    <h4>@Lang["Home.SmartDashboard"]</h4> 
                    <p class="ff-preview-sub">@Lang["Home.TrackDailyProgress"]</p> 

                    <div class="ff-preview-metrics">
                        <div>
                            <span class="ff-metric-label">@Lang["Decks.StudiedToday"]</span>
                            <span class="ff-metric-value">24</span>
                        </div>
                        <div>
                            <span class="ff-metric-label">@Lang["Study.AverageScore"]</span>
                            <span class="ff-metric-value">4.2</span>
                        </div>
                        <div>
                            <span class="ff-metric-label">@Lang["Home.AverageEF"]</span> 
                            <span class="ff-metric-value">2.65</span>
                        </div>
                    </div>

                    <div class="ff-chart-placeholder">
                        📈 @Lang["Home.Progress30Days"]
                    </div>
                </div>

                <div class="ff-preview-card">
                    <h4>@Lang["Home.SpeakingSession"]</h4>

                    <div class="ff-session-list-preview">
                        <div class="ff-session-row">
                            <span class="ff-session-word">butterfly</span>
                            <span class="ff-session-score ff-score-good">92%</span>
                        </div>
                        <div class="ff-session-row">
                            <span class="ff-session-word">perseverance</span>
                            <span class="ff-session-score ff-score-warn">71%</span>
                        </div>
                        <div class="ff-session-row">
                            <span class="ff-session-word">acknowledge</span>
                            <span class="ff-session-score ff-score-good">88%</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Features -->
        <section class="ff-section">
            <h2>@Lang["Home.WhyDifferent"]</h2>

            <div class="ff-features">
                <div class="ff-feature">
                    <div class="ff-feature-icon">🎧</div>
                    <h3>@Lang["Home.Feature.Multimodal"]</h3>
                    <p>@Lang["Home.Feature.Multimodal.Desc"]</p> 
                </div>

                <div class="ff-feature">
                    <div class="ff-feature-icon">🧠</div>
                    <h3>@Lang["Home.Feature.SM2"]</h3> 
                    <p>@Lang["Home.Feature.SM2.Desc"]</p> 
                </div>

                <div class="ff-feature">
                    <div class="ff-feature-icon">📊</div>
                    <h3>@Lang["Home.Feature.ActionableDashboards"]</h3> 
                    <p>@Lang["Home.Feature.ActionableDashboards.Desc"]</p> 
                </div>

                <div class="ff-feature">
                    <div class="ff-feature-icon">🗣️</div>
                    <h3>@Lang["Home.Feature.PronunciationFeedback"]</h3> 
                    <p>@Lang["Home.Feature.PronunciationFeedback.Desc"]</p> 
                </div>
            </div>
        </section>

        <!-- Como funciona -->
        <section class="ff-section ff-section-alt">
            <h2>@Lang["Home.HowItWorks"]</h2> 

            <ol class="ff-steps">
                <li><strong>@Lang["Home.Step.CreateAccount"]</strong> @Lang["Home.Step.CreateAccount.Desc"]</li>
                <li><strong>@Lang["Home.Step.CreateDeck"]</strong> @Lang["Home.Step.CreateDeck.Desc"]</li>
                <li><strong>@Lang["Home.Step.ShortSessions"]</strong> @Lang["Home.Step.ShortSessions.Desc"]</li>
                <li><strong>@Lang["Home.Step.TrackDashboard"]</strong> @Lang["Home.Step.TrackDashboard.Desc"]</li>
            </ol>
        </section>

        <!-- CTA -->
        <section class="ff-section ff-cta">
            <div class="ff-cta-box">
                <h2>@Lang["Home.CTA.Title"]</h2> 
                <p>@Lang["Home.CTA.Subtitle"]</p> 

                <button class="ff-btn-primary" @onclick="@(() => Nav.NavigateTo("/register"))">
                    @Lang["Home.CTA.Button"] 
                </button>
            </div>
        </section>
    </MudContainer>
}

<style>
