</style>

@code {
    private bool   _checkingAuth   = true;
    private bool   _isAuthenticated;
    private string _userName       = "";
    private bool   _loadingDecks   = true;

    // Dados para a vista autenticada
    private PagedResult<DeckDto>? _decks;
    private List<DeckSummary>     _deckSummaries = [];
    private int _totalDueToday;
    private int _totalStudiedToday;
    private int _totalCards;
    
    private static int GetPct(DeckSummary obj)
    {
        if (obj.Dashboard.TotalCards <= 0)
            return 0;

        var pct = (int)((obj.Dashboard.StudiedToday /
                         (double)Math.Max(obj.Dashboard.DueToday + obj.Dashboard.NewToday, 1))
                        * 100);

        return Math.Min(pct, 100);
    }

    private record DeckSummary(DeckDto Deck, DashboardDto? Dashboard);

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        _isAuthenticated = authState.User.Identity?.IsAuthenticated ?? false;

        if (_isAuthenticated)
        {
            _userName = authState.User.FindFirst(
                System.Security.Claims.ClaimTypes.Name)?.Value
                ?? authState.User.FindFirst("name")?.Value
                ?? "utilizador";

            await LoadDecks();
        }

        _checkingAuth = false;
    }
    
    private async Task LoadDecks()
    {
        try
        {
            _decks = await Api.GetDecksAsync(pageSize: 6);

            if (_decks?.Items.Count > 0)
            {
                var tasks = _decks.Items.Select(async deck =>
                {
                    var dashboard = await Api.GetDashboardAsync(deck.Id);
                    return new DeckSummary(deck, dashboard);
                });

                _deckSummaries = (await Task.WhenAll(tasks)).ToList();

                _totalDueToday     = _deckSummaries.Sum(s => s.Dashboard?.DueToday     ?? 0);
                _totalStudiedToday = _deckSummaries.Sum(s => s.Dashboard?.StudiedToday ?? 0);
                _totalCards        = _deckSummaries.Sum(s => s.Dashboard?.TotalCards   ?? 0);
            }
        }
        catch
        {
            // Se a API não responder, mostrar o estado vazio em vez de ficar preso
        }
        finally
        {
            // finally garante que _loadingDecks é sempre false,
            // mesmo se a API falhar
            _loadingDecks = false;

            // InvokeAsync + StateHasChanged é o padrão correcto
            // para re-renderizar a partir de código assíncrono
            await InvokeAsync(StateHasChanged);
        }
    }
}