@page "/"
@layout EmptyLayout
@inject NavigationManager Nav
@inject ApiClient Api
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>FluentFlow — Fluência que flui com o teu ritmo</PageTitle>

@if (_checkingAuth)
{
    @* Silencioso — o loading global já está activo *@
}
else if (_isAuthenticated)
{
    @* ═══════════════════════════════════════════════════
        VISTA AUTENTICADA — Dashboard resumido
    ═══════════════════════════════════════════════════ *@
    <div class="ff-auth-home">
        <!-- Header -->
        <header class="ff-header">
            <div class="ff-logo">
                <div class="ff-logo-icon">F</div>
                <span class="ff-logo-text-main">Fluent</span><span class="ff-logo-text-accent">Flow</span>
            </div>
            <nav class="ff-nav">
                <button class="ff-btn-link" @onclick="@(() => Nav.NavigateTo("/decks"))">
                    Os meus Decks
                </button>
            </nav>
        </header>

        <MudContainer MaxWidth="MaxWidth.Large" Class="mt-8">
            <MudText Typo="Typo.h4" Class="mb-1">
                Bem-vindo de volta, <strong>@_userName</strong>
            </MudText>
            <MudText Typo="Typo.body1" Color="Color.Secondary" Class="mb-6">
                @DateTime.Now.ToString("dddd, d 'de' MMMM", new System.Globalization.CultureInfo("pt-PT"))
            </MudText>

            @if (_loadingDecks)
            {
                <LoadingSpinner />
            }
            else if (_decks is null || _decks.TotalCount == 0)
            {
                <!-- Sem decks — onboarding -->
                <MudPaper Class="pa-8 text-center" Elevation="2" Style="max-width:520px; margin:0 auto;">
                    <MudIcon Icon="@Icons.Material.Filled.LibraryBooks" Style="font-size:3rem; color:var(--mud-palette-primary);" Class="mb-4" />
                    <MudText Typo="Typo.h5" Class="mb-2">Ainda não tens decks</MudText>
                    <MudText Typo="Typo.body1" Color="Color.Secondary" Class="mb-6">
                        Cria o teu primeiro deck e começa a estudar hoje mesmo.
                    </MudText>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large" StartIcon="@Icons.Material.Filled.Add"
                               OnClick="@(() => Nav.NavigateTo("/decks"))">
                        Criar primeiro deck
                    </MudButton>
                </MudPaper>
            }
            else
            {
                <!-- Resumo geral -->
                <MudGrid Class="mb-8">
                    <MudItem xs="6" sm="3">
                        <MudPaper Class="pa-4 text-center" Elevation="1">
                            <MudText Typo="Typo.h4" Color="Color.Primary" Style="font-weight:700">
                                @_decks.TotalCount
                            </MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Decks</MudText>
                        </MudPaper>
                    </MudItem>
                    <MudItem xs="6" sm="3">
                        <MudPaper Class="pa-4 text-center" Elevation="1">
                            <MudText Typo="Typo.h4" Color="Color.Warning" Style="font-weight:700">
                                @_totalDueToday
                            </MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Para rever hoje</MudText>
                        </MudPaper>
                    </MudItem>
                    <MudItem xs="6" sm="3">
                        <MudPaper Class="pa-4 text-center" Elevation="1">
                            <MudText Typo="Typo.h4" Color="Color.Success" Style="font-weight:700">
                                @_totalStudiedToday
                            </MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Estudadas hoje</MudText>
                        </MudPaper>
                    </MudItem>
                    <MudItem xs="6" sm="3">
                        <MudPaper Class="pa-4 text-center" Elevation="1">
                            <MudText Typo="Typo.h4" Color="Color.Info" Style="font-weight:700">
                                @_totalCards
                            </MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Cards totais</MudText>
                        </MudPaper>
                    </MudItem>
                </MudGrid>

                <!-- Decks com actividade -->
                <MudText Typo="Typo.h6" Class="mb-3">Os teus decks</MudText>
                <MudGrid>
                    @foreach (var item in _deckSummaries)
                    {
                        var d = item;
                        <MudItem xs="12" sm="6" md="4">
                            <MudCard Elevation="2" Style="height:100%">
                                <MudCardContent>
                                    <MudStack Row AlignItems="AlignItems.Center" Class="mb-2">
                                        <MudText Typo="Typo.h6" Style="flex:1">@d.Deck.Name</MudText>
                                        <MudChip T="string" Size="Size.Small" Color="Color.Default">
                                            @d.Deck.Language.ToUpper()
                                        </MudChip>
                                    </MudStack>

                                    @if (d.Dashboard is not null)
                                    {
                                        <MudStack Row Spacing="3" Class="mb-3">
                                            <div>
                                                <MudText Typo="Typo.caption" Color="Color.Secondary">
                                                    Para hoje
                                                </MudText>
                                                <MudText Typo="Typo.body1" Color="Color.Warning" Style="font-weight:600">
                                                    @d.Dashboard.DueToday
                                                </MudText>
                                            </div>
                                            <div>
                                                <MudText Typo="Typo.caption" Color="Color.Secondary">
                                                    Novas
                                                </MudText>
                                                <MudText Typo="Typo.body1" Color="Color.Info" Style="font-weight:600">
                                                    @d.Dashboard.NewToday
                                                </MudText>
                                            </div>
                                            <div>
                                                <MudText Typo="Typo.caption" Color="Color.Secondary">
                                                    Total
                                                </MudText>
                                                <MudText Typo="Typo.body1" Style="font-weight:600">
                                                    @d.Dashboard.TotalCards
                                                </MudText>
                                            </div>
                                        </MudStack>
                                        
                                        <MudProgressLinear Value="@GetPct(d)" Color="@(@GetPct(d) >= 100 ? Color.Success : Color.Primary)" Rounded="true" Size="Size.Small" Class="mb-1" />
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                                            @(@GetPct(d) >= 100 ? "✓ Sessão do dia completa" : $"{@GetPct(d)}% do plano de hoje")
                                        </MudText>
                                    }
                                </MudCardContent>
                                <MudCardActions>
                                    @if (d.Dashboard?.DueToday > 0 || d.Dashboard?.NewToday > 0)
                                    {
                                        <MudButton Color="Color.Primary" Variant="Variant.Filled" Size="Size.Small" StartIcon="@Icons.Material.Filled.School"
                                                   OnClick="@(() => Nav.NavigateTo($"/decks/{d.Deck.Id}/study"))">
                                            Estudar agora
                                        </MudButton>
                                    }
                                    else
                                    {
                                        <MudButton Color="Color.Success" Variant="Variant.Text" Size="Size.Small" StartIcon="@Icons.Material.Filled.CheckCircle" Disabled>
                                            Em dia
                                        </MudButton>
                                    }
                                    <MudButton Color="Color.Default"
                                               Variant="Variant.Text"
                                               Size="Size.Small"
                                               OnClick="@(() => Nav.NavigateTo($"/decks/{d.Deck.Id}"))">
                                        Ver detalhes
                                    </MudButton>
                                </MudCardActions>
                            </MudCard>
                        </MudItem>
                    }
                </MudGrid>

                <MudStack Row Justify="Justify.Center" Class="mt-6">
                    <MudButton Variant="Variant.Outlined"
                               StartIcon="@Icons.Material.Filled.LibraryBooks"
                               OnClick="@(() => Nav.NavigateTo("/decks"))">
                        Ver todos os decks
                    </MudButton>
                </MudStack>
            }
        </MudContainer>
    </div>
}
else
{
    @* ═══════════════════════════════════════════════════
        VISTA ANÓNIMA — Landing page
    ═══════════════════════════════════════════════════ *@
    <MudContainer MaxWidth="MaxWidth.ExtraLarge">
        <header class="ff-header">
            <div class="ff-logo">
                <div class="ff-logo-icon">F</div>
                <span class="ff-logo-text-main">Fluent</span><span class="ff-logo-text-accent">Flow</span>
            </div>
            <div class="ff-header-right">
                <button class="ff-btn-link" @onclick="@(() => Nav.NavigateTo("/login"))">
                    Login
                </button>
                <button class="ff-btn-primary-small" @onclick="@(() => Nav.NavigateTo("/register"))">
                    Registre-se
                </button>
            </div>
        </header>

        <!-- Hero -->
        <div class="ff-hero">
            <div class="ff-hero-left">
                <h1 class="ff-title">Fluência que flui com o teu ritmo.</h1>
                <p class="ff-subtitle">
                    Listening, speaking e repetição espaçada (SM‑2) num fluxo contínuo de
                    aprendizagem, com dashboards inteligentes e feedback real sobre o teu progresso.
                </p>
                <div class="ff-actions">
                    <button class="ff-btn-primary" @onclick="@(() => Nav.NavigateTo("/register"))">
                        Começar agora
                    </button>
                    <button class="ff-btn-outline" @onclick="@(() => Nav.NavigateTo("/login"))">
                        Já tenho conta
                    </button>
                </div>
                <div class="ff-tags">
                    <span>🎧 Listening</span>
                    <span>🗣️ Speaking</span>
                    <span>⏱️ SM‑2</span>
                    <span>📊 Dashboards</span>
                </div>
            </div>

            <div class="ff-hero-right">
                <!-- Card de preview animado -->
                <div class="ff-preview-card">
                    <h4>Dashboard Inteligente</h4>
                    <p class="ff-preview-sub">Acompanha o teu progresso diário</p>
                    <div class="ff-preview-metrics">
                        <div>
                            <span class="ff-metric-label">Reviews hoje</span>
                            <span class="ff-metric-value">24</span>
                        </div>
                        <div>
                            <span class="ff-metric-label">Score médio</span>
                            <span class="ff-metric-value">4.2</span>
                        </div>
                        <div>
                            <span class="ff-metric-label">EF médio</span>
                            <span class="ff-metric-value">2.65</span>
                        </div>
                    </div>
                    <div class="ff-chart-placeholder">📈 Progresso (últimos 30 dias)</div>
                </div>

                <div class="ff-preview-card">
                    <h4>Sessão de Speaking</h4>
                    <div class="ff-session-list-preview">
                        <div class="ff-session-row">
                            <span class="ff-session-word">butterfly</span>
                            <span class="ff-session-score ff-score-good">92%</span>
                        </div>
                        <div class="ff-session-row">
                            <span class="ff-session-word">perseverance</span>
                            <span class="ff-session-score ff-score-warn">71%</span>
                        </div>
                        <div class="ff-session-row">
                            <span class="ff-session-word">acknowledge</span>
                            <span class="ff-session-score ff-score-good">88%</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Features -->
        <section class="ff-section">
            <h2>Porque o FluentFlow é diferente?</h2>
            <div class="ff-features">
                <div class="ff-feature">
                    <div class="ff-feature-icon">🎧</div>
                    <h3>Estudo multimodal</h3>
                    <p>Listening e speaking no mesmo deck, com métricas separadas e histórico unificado.</p>
                </div>
                <div class="ff-feature">
                    <div class="ff-feature-icon">🧠</div>
                    <h3>SM‑2 real</h3>
                    <p>Intervalos, EF e repetições calculados com o algoritmo original de repetição espaçada.</p>
                </div>
                <div class="ff-feature">
                    <div class="ff-feature-icon">📊</div>
                    <h3>Dashboards accionáveis</h3>
                    <p>Actividade diária, distribuição de scores, novos/due/overdue e planeamento do dia.</p>
                </div>
                <div class="ff-feature">
                    <div class="ff-feature-icon">🗣️</div>
                    <h3>Feedback de pronúncia</h3>
                    <p>Similaridade de Levenshtein em tempo real — sabes exactamente onde melhorar.</p>
                </div>
            </div>
        </section>

        <!-- Como funciona -->
        <section class="ff-section ff-section-alt">
            <h2>Como funciona?</h2>
            <ol class="ff-steps">
                <li><strong>Cria a tua conta.</strong> Acesso seguro com JWT ou login social.</li>
                <li><strong>Cria um deck e faz upload de áudio.</strong> O Whisper transcreve automaticamente.</li>
                <li><strong>Estuda em sessões curtas.</strong> O sistema escolhe novos, due e overdue.</li>
                <li><strong>Acompanha o dashboard.</strong> Ajusta o ritmo com base nos últimos 30 dias.</li>
            </ol>
        </section>

        <!-- CTA -->
        <section class="ff-section ff-cta">
            <div class="ff-cta-box">
                <h2>Pronto para pôr o teu inglês em fluxo?</h2>
                <p>Cria a tua conta e começa a evoluir hoje mesmo.</p>
                <button class="ff-btn-primary" @onclick="@(() => Nav.NavigateTo("/register"))">
                    Criar conta gratuita
                </button>
            </div>
        </section>
    </MudContainer>
}

<style>
