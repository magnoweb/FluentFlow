    .ff-header {
        display: flex; align-items: center; justify-content: space-between;
        padding: 20px 32px;
        background: #fff;
        border-bottom: 1px solid #EBEBEB;
    }
    .ff-logo { display: flex; align-items: center; gap: 6px; }
    .ff-logo-icon {
        width: 34px; height: 34px; border-radius: 8px;
        background: #594AE2; color: #fff;
        font-weight: 700; font-size: 1rem;
        display: flex; align-items: center; justify-content: center;
    }
    .ff-logo-text-main  { font-size: 1.2rem; font-weight: 700; color: #1A1A2E; }
    .ff-logo-text-accent{ font-size: 1.2rem; font-weight: 700; color: #594AE2; }

    .ff-nav { display: flex; gap: 8px; }
    .ff-header-right { display: flex; align-items: center; gap: 12px; }

