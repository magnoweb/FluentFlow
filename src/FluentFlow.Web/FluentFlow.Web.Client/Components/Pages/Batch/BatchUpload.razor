@inject ApiClient Api
@inject ISnackbar Snackbar
@inject IJSRuntime JS

@if (_jobId is null)
{
    <MudStack Class="ma-4" Spacing="4">

        <MudText Typo="Typo.body1">
            @Lang["Batch.InfoText"]
        </MudText>

        <MudFileUpload T="IReadOnlyList<IBrowserFile>" FilesChanged="OnFilesChanged" Accept=".wav,.mp3,.m4a,.ogg,.flac" Multiple>
            <ActivatorContent>
                <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.CloudUpload" Color="Color.Primary">
                    @Lang["Batch.SelectFiles"]
                </MudButton>
            </ActivatorContent>
        </MudFileUpload>

        @if (_files.Count > 0)
        {
            <MudList T="IBrowserFile" Dense>
                @foreach (var f in _files)
                {
                    <MudListItem T="IBrowserFile" Icon="@Icons.Material.Filled.AudioFile" Text="@($"{f.Name} ({f.Size / 1024} KB)")" />
                }
            </MudList>

            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Upload"
                       OnClick="UploadAsync"
                       Disabled="_uploading">
                @if (_uploading)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate Class="mr-2" />
                }
                @Lang["Batch.SendFiles"] @_files.Count
            </MudButton>
        }
    </MudStack>
}
else
{
    <!-- Progresso do job -->
    <MudStack Class="my-4" Spacing="3">

        <MudText Typo="Typo.h6">@Lang["Batch.Processing"]</MudText>
        <MudProgressLinear Value="_progressValue" Color="Color.Primary" Rounded Size="Size.Large" Class="mb-2" />

        <MudText Typo="Typo.body2">
            @string.Format(Lang["Batch.ProcessedCount"], _processed, _total)

            @if (_failed > 0)
            {
                <MudChip T="string" Color="Color.Error" Size="Size.Small" Text="@string.Format(Lang["Batch.Failures"], _failed)" />
            }
        </MudText>

        @if (!string.IsNullOrEmpty(_currentFile))
        {
            <MudText Typo="Typo.caption" Color="Color.Secondary">
                @string.Format(Lang["Batch.ProcessingFile"], _currentFile)
            </MudText>
        }

        @if (_status is "Completed" or "PartialSuccess" or "Failed")
        {
            <MudAlert Severity="@(_status == "Failed"
                                ? Severity.Error
                                : _status == "PartialSuccess"
                                    ? Severity.Warning
                                    : Severity.Success)">

                @(_status == "Completed"
                    ? Lang["Batch.UploadCompleted"]
                    : _status == "PartialSuccess"
                        ? string.Format(Lang["Batch.UploadPartial"], _failed)
                        : Lang["Batch.UploadFailed"])
            </MudAlert>

            <MudButton Variant="Variant.Outlined" OnClick="Reset">
                @Lang["Batch.NewUpload"]
            </MudButton>
        }
    </MudStack>
}

@code {
    [Parameter, EditorRequired] public Guid DeckId { get; set; }

    private List<IBrowserFile> _files    = [];
    private bool   _uploading;
    private Guid?  _jobId;
    private int    _total, _processed, _failed;
    private double _progressValue;
    private string _status      = "";
    private string _currentFile = "";

    // Polling interval quando SignalR não está disponível
    private Timer? _pollTimer;

    private void OnFilesChanged(IReadOnlyList<IBrowserFile> files)
    {
        _files = files.ToList();
        StateHasChanged();
    }

    private async Task UploadAsync()
    {
        if (_files.Count == 0) return;

        _uploading = true;

        using var content = new MultipartFormDataContent();
        foreach (var file in _files)
        {
            var stream = file.OpenReadStream(maxAllowedSize: 50 * 1024 * 1024); // 50 MB
            content.Add(new StreamContent(stream), "files", file.Name);
        }

        var response = await Api.UploadBatchAsync(DeckId, content);

        if (response.Success)
        {
            _jobId  = response.Value;
            _total  = _files.Count;
            StartPolling();
        }
        else
        {
            Snackbar.Add(response.Error, Severity.Error);
        }

        _uploading = false;
    }

    private void StartPolling()
    {
        // Poll a cada 2 segundos para actualizar o progresso
        _pollTimer = new System.Threading.Timer(
            async void (_) => await PollProgressAsync(),
            null,
            TimeSpan.Zero,
            TimeSpan.FromSeconds(2));
    }

    private async Task PollProgressAsync()
    {
        if (_jobId is null) return;

        var job = await Api.GetJobAsync(_jobId.Value);
        if (job is null) return;

        _total         = job.TotalFiles;
        _processed     = job.ProcessedFiles;
        _failed        = job.FailedFiles;
        _status        = job.Status;
        _progressValue = _total > 0 ? (_processed / (double)_total) * 100 : 0;

        await InvokeAsync(StateHasChanged);

        if (_status is "Completed" or "PartialSuccess" or "Failed")
            StopPolling();
    }

    private void StopPolling()
    {
        _pollTimer?.Dispose();
        _pollTimer = null;
    }

    private void Reset()
    {
        StopPolling();
        _jobId      = null;
        _files      = [];
        _status     = "";
        _processed  = _total = _failed = 0;
    }

    public void Dispose() => StopPolling();
}