@page "/not-found"
@layout MainLayout

<PageTitle>Página não encontrada</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-16 text-center">
    <MudText Typo="Typo.h3" Class="mb-4">404</MudText>
    <MudText Typo="Typo.h6" Class="mb-6">Página não encontrada.</MudText>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/">
        Voltar ao início
    </MudButton>
</MudContainer>