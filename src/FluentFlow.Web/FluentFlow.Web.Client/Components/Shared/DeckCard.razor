<MudCard Elevation="2">
    <MudCardContent Style="cursor:pointer" @onclick="OnDetail">
        <MudText Typo="Typo.h6">@Deck.Name</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">
            @Deck.Language.ToUpper() → @Deck.TotalCards @Lang["Decks.Cards"]
        </MudText>
        @if (Deck.Description is not null)
        {
            <MudText Typo="Typo.body2" Class="mt-2">@Deck.Description</MudText>
        }
    </MudCardContent>
    <MudCardActions>
        <MudButton StartIcon="@Icons.Material.Filled.School"
                   Color="Color.Primary" OnClick="OnStudy">
            @Lang["Common.Study"]
        </MudButton>
        <MudButton StartIcon="@Icons.Material.Filled.Edit"
                   OnClick="OnEdit">
            @Lang["Common.Edit"]
        </MudButton>
        <MudButton StartIcon="@Icons.Material.Filled.Delete"
                   Color="Color.Error" OnClick="OnDelete">
            @Lang["Common.Delete"]
        </MudButton>
    </MudCardActions>
</MudCard>

@code {
    [Parameter, EditorRequired] public DeckDto Deck { get; set; } = null!;
    [Parameter] public EventCallback OnStudy  { get; set; }
    [Parameter] public EventCallback OnEdit { get; set; }
    [Parameter] public EventCallback OnDetail { get; set; }
    [Parameter] public EventCallback OnDelete { get; set; }
}